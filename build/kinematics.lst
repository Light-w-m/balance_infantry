 115:Robot/Controller/kinematics.c ****     leg->rod.phi0 = atan2f(leg->rod.yC, leg->rod.xC);
 116:Robot/Controller/kinematics.c **** 
 117:Robot/Controller/kinematics.c ****     //LQR控制器参数
 118:Robot/Controller/kinematics.c ****     leg->rod.d_phi0 = (leg->rod.phi0 - leg->rod.last_phi0) / dt;
 119:Robot/Controller/kinematics.c ****     
 120:Robot/Controller/kinematics.c ****     leg->rod.last_phi0 = leg->rod.phi0;
 121:Robot/Controller/kinematics.c **** 
 122:Robot/Controller/kinematics.c ****     //theta
 123:Robot/Controller/kinematics.c ****     leg->rod.theta = PI/2 - leg->rod.phi0 - PitchR; //状态量1
 124:Robot/Controller/kinematics.c ****     leg->rod.d_theta = - leg->rod.d_phi0 - PitchGyroR; //状态量2
 125:Robot/Controller/kinematics.c ****     leg->rod.dd_theta = (leg->rod.d_theta - leg->rod.last_d_theta) / dt;
 126:Robot/Controller/kinematics.c ****     leg->rod.last_d_theta = leg->rod.d_theta;
 127:Robot/Controller/kinematics.c **** 
 128:Robot/Controller/kinematics.c ****     //L0
 129:Robot/Controller/kinematics.c ****     leg->rod.d_L0 = (leg->rod.L0 - leg->rod.last_L0) / dt;
 130:Robot/Controller/kinematics.c ****     leg->rod.dd_L0 = (leg->rod.d_L0 - leg->rod.last_d_L0) / dt;
 131:Robot/Controller/kinematics.c **** 
 132:Robot/Controller/kinematics.c ****     leg->rod.last_L0 = leg->rod.L0;
 133:Robot/Controller/kinematics.c ****     leg->rod.last_d_L0 = leg->rod.d_L0;
 134:Robot/Controller/kinematics.c **** 
