 127:Robot/Controller/kinematics.c **** /**
 128:Robot/Controller/kinematics.c ****  * @brief 正运动学解算，求解足端坐标
 129:Robot/Controller/kinematics.c ****  * 
 130:Robot/Controller/kinematics.c ****  * @param leg 
 131:Robot/Controller/kinematics.c ****  * @param excessive 
 132:Robot/Controller/kinematics.c ****  * @param ins 
 133:Robot/Controller/kinematics.c ****  */
 134:Robot/Controller/kinematics.c **** void ForwardKinematics(Leg_t* leg,Excessive_t* excessive)
 135:Robot/Controller/kinematics.c **** {
 136:Robot/Controller/kinematics.c ****     float XD, YD, XB, YB;
 137:Robot/Controller/kinematics.c ****     float lBD;
 138:Robot/Controller/kinematics.c ****     float A0, B0, C0;
 139:Robot/Controller/kinematics.c **** 
 140:Robot/Controller/kinematics.c ****     XD = LEG4*arm_cos_f32(leg->joint.Phi4);
 141:Robot/Controller/kinematics.c ****     YD = LEG4*arm_sin_f32(leg->joint.Phi4);
 142:Robot/Controller/kinematics.c ****     XB = LEG1*arm_cos_f32(leg->joint.Phi1);
 143:Robot/Controller/kinematics.c ****     YB = LEG1*arm_sin_f32(leg->joint.Phi1);
 144:Robot/Controller/kinematics.c **** 
 145:Robot/Controller/kinematics.c ****     lBD = safe_sqrt((XD - XB)*(XD - XB) + (YD -YB)*(YD - YB));
 146:Robot/Controller/kinematics.c **** 
 147:Robot/Controller/kinematics.c ****     A0 = 2*LEG2*(XD - XB);
 148:Robot/Controller/kinematics.c ****     B0 = 2*LEG2*(YD - YB);
 149:Robot/Controller/kinematics.c ****     C0 = LEG2*LEG2 + lBD * lBD - LEG3*LEG3;
 150:Robot/Controller/kinematics.c **** 
 151:Robot/Controller/kinematics.c ****     excessive->Phi2 = 2*atan2f(B0 + safe_sqrt(A0*A0 + B0*B0 - C0*C0), A0 + C0);
 152:Robot/Controller/kinematics.c ****     excessive->Phi3 = atan2f(YB - YD + LEG2*arm_sin_f32(excessive->Phi2), XB - XD + LEG2*arm_cos_f3
 153:Robot/Controller/kinematics.c **** 
 154:Robot/Controller/kinematics.c ****     leg->rod.xC = LEG1*arm_cos_f32(leg->joint.Phi1) + LEG2*arm_cos_f32(excessive->Phi2);
 155:Robot/Controller/kinematics.c ****     leg->rod.yC = LEG1*arm_sin_f32(leg->joint.Phi1) + LEG2*arm_sin_f32(excessive->Phi2);
 156:Robot/Controller/kinematics.c **** 
 157:Robot/Controller/kinematics.c ****     leg->rod.L0 = safe_sqrt(leg->rod.xC*leg->rod.xC + leg->rod.yC*leg->rod.yC);
 158:Robot/Controller/kinematics.c ****     leg->rod.phi0 = atan2f(leg->rod.yC, leg->rod.xC);
 159:Robot/Controller/kinematics.c **** }
