  86:Robot/Controller/kinematics.c **** void ForwardKinematics(Leg_t* leg,Excessive_t* excessive, INS_t* ins, float dt)
  87:Robot/Controller/kinematics.c **** {
  88:Robot/Controller/kinematics.c ****     float XD, YD, XB, YB;
  89:Robot/Controller/kinematics.c ****     float lBD;
  90:Robot/Controller/kinematics.c ****     float A0, B0, C0;
  91:Robot/Controller/kinematics.c **** 
  92:Robot/Controller/kinematics.c ****     static float PitchR = 0.0f;
  93:Robot/Controller/kinematics.c ****     static float PitchGyroR = 0.0f;
  94:Robot/Controller/kinematics.c ****     PitchR = ins->Pitch;
  95:Robot/Controller/kinematics.c ****     PitchGyroR = ins->Gyro[0];
  96:Robot/Controller/kinematics.c **** 
  97:Robot/Controller/kinematics.c ****     XD = LEG4*arm_cos_f32(leg->joint.Phi4);
  98:Robot/Controller/kinematics.c ****     YD = LEG4*arm_sin_f32(leg->joint.Phi4);
  99:Robot/Controller/kinematics.c ****     XB = LEG1*arm_cos_f32(leg->joint.Phi1);
 100:Robot/Controller/kinematics.c ****     YB = LEG1*arm_sin_f32(leg->joint.Phi1);
 101:Robot/Controller/kinematics.c **** 
 102:Robot/Controller/kinematics.c ****     lBD = safe_sqrt((XD - XB)*(XD - XB) + (YD -YB)*(YD - YB));
 103:Robot/Controller/kinematics.c **** 
 104:Robot/Controller/kinematics.c ****     A0 = 2*LEG2*(XD - XB);
 105:Robot/Controller/kinematics.c ****     B0 = 2*LEG2*(YD - YB);
 106:Robot/Controller/kinematics.c ****     C0 = LEG2*LEG2 + lBD * lBD - LEG3*LEG3;
 107:Robot/Controller/kinematics.c **** 
 108:Robot/Controller/kinematics.c ****     excessive->Phi2 = 2*atan2f(B0 + safe_sqrt(A0*A0 + B0*B0 - C0*C0), A0 + C0);
 109:Robot/Controller/kinematics.c ****     excessive->Phi3 = atan2f(YB - YD + LEG2*arm_sin_f32(excessive->Phi2), XB - XD + LEG2*arm_cos_f3
 110:Robot/Controller/kinematics.c **** 
 111:Robot/Controller/kinematics.c ****     leg->rod.xC = LEG1*arm_cos_f32(leg->joint.Phi1) + LEG2*arm_cos_f32(excessive->Phi2);
 112:Robot/Controller/kinematics.c ****     leg->rod.yC = LEG1*arm_sin_f32(leg->joint.Phi1) + LEG2*arm_sin_f32(excessive->Phi2);
