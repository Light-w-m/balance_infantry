 119:Robot/Controller/kinematics.c ****  */
 120:Robot/Controller/kinematics.c **** void ForwardKinematics(Leg_t* leg,Excessive_t* excessive)
 121:Robot/Controller/kinematics.c **** {
 122:Robot/Controller/kinematics.c ****     float XD, YD, XB, YB;
 123:Robot/Controller/kinematics.c ****     float lBD;
 124:Robot/Controller/kinematics.c ****     float A0, B0, C0;
 125:Robot/Controller/kinematics.c **** 
ARM GAS  D:\temp\TMP\ccXUPUea.s 			page 10


 126:Robot/Controller/kinematics.c ****     XD = LEG4*arm_cos_f32(leg->joint.Phi4);
 127:Robot/Controller/kinematics.c ****     YD = LEG4*arm_sin_f32(leg->joint.Phi4);
 128:Robot/Controller/kinematics.c ****     XB = LEG1*arm_cos_f32(leg->joint.Phi1);
 129:Robot/Controller/kinematics.c ****     YB = LEG1*arm_sin_f32(leg->joint.Phi1);
 130:Robot/Controller/kinematics.c **** 
 131:Robot/Controller/kinematics.c ****     lBD = safe_sqrt((XD - XB)*(XD - XB) + (YD -YB)*(YD - YB));
 132:Robot/Controller/kinematics.c **** 
 133:Robot/Controller/kinematics.c ****     A0 = 2*LEG2*(XD - XB);
 134:Robot/Controller/kinematics.c ****     B0 = 2*LEG2*(YD - YB);
 135:Robot/Controller/kinematics.c ****     C0 = LEG2*LEG2 + lBD * lBD - LEG3*LEG3;
 136:Robot/Controller/kinematics.c **** 
 137:Robot/Controller/kinematics.c ****     excessive->Phi2 = 2*atan2f(B0 + safe_sqrt(A0*A0 + B0*B0 - C0*C0), A0 + C0);
 138:Robot/Controller/kinematics.c ****     excessive->Phi3 = atan2f(YB - YD + LEG2*arm_sin_f32(excessive->Phi2), XB - XD + LEG2*arm_cos_f3
 139:Robot/Controller/kinematics.c **** 
 140:Robot/Controller/kinematics.c ****     leg->rod.xC = LEG1*arm_cos_f32(leg->joint.Phi1) + LEG2*arm_cos_f32(excessive->Phi2);
 141:Robot/Controller/kinematics.c ****     leg->rod.yC = LEG1*arm_sin_f32(leg->joint.Phi1) + LEG2*arm_sin_f32(excessive->Phi2);
 142:Robot/Controller/kinematics.c **** 
 143:Robot/Controller/kinematics.c ****     leg->rod.L0 = safe_sqrt(leg->rod.xC*leg->rod.xC + leg->rod.yC*leg->rod.yC);
 144:Robot/Controller/kinematics.c ****     leg->rod.phi0 = atan2f(leg->rod.yC, leg->rod.xC);
 145:Robot/Controller/kinematics.c **** }
