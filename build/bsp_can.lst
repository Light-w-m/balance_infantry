 113:BSP/bsp_can.c **** /**
 114:BSP/bsp_can.c ****  * @brief 在第一个CAN实例初始化的时候会自动调用此函数,启动CAN服务
 115:BSP/bsp_can.c ****  *
 116:BSP/bsp_can.c ****  * @note 此函数会启动CAN1并开启中断
 117:BSP/bsp_can.c ****  *       FDCAN的情况下，我们采用FIFO接收方式（而不是buffer），FIFO和buffer还�
 118:BSP/bsp_can.c ****  *       FDCAN比bxCAN多了一个全局过滤器，这里配置为全部拒绝，只接受指定ID
 119:BSP/bsp_can.c ****  *       
 120:BSP/bsp_can.c ****  */
 121:BSP/bsp_can.c **** void CANServiceInit()
 122:BSP/bsp_can.c **** {
 123:BSP/bsp_can.c **** #ifdef FDCAN
 124:BSP/bsp_can.c **** 	//可能不需要这么多中断
 125:BSP/bsp_can.c **** 	uint32_t FDCAN_RXActiveITs = FDCAN_IT_RX_FIFO0_NEW_MESSAGE|FDCAN_IT_RX_FIFO0_FULL\
 126:BSP/bsp_can.c **** 			|FDCAN_IT_RX_FIFO0_WATERMARK|FDCAN_IT_RX_FIFO0_MESSAGE_LOST \
 127:BSP/bsp_can.c **** 			|FDCAN_IT_RX_FIFO1_NEW_MESSAGE| FDCAN_IT_RX_FIFO1_FULL\
 128:BSP/bsp_can.c **** 			|FDCAN_IT_RX_FIFO1_WATERMARK|FDCAN_IT_RX_FIFO1_MESSAGE_LOST;
 129:BSP/bsp_can.c **** 
 130:BSP/bsp_can.c **** 
 131:BSP/bsp_can.c **** 	HAL_FDCAN_ConfigRxFifoOverwrite(&hfdcan2,FDCAN_RX_FIFO0,FDCAN_RX_FIFO_OVERWRITE);
 132:BSP/bsp_can.c **** 	HAL_FDCAN_ConfigRxFifoOverwrite(&hfdcan2,FDCAN_RX_FIFO1,FDCAN_RX_FIFO_OVERWRITE);
 133:BSP/bsp_can.c **** 	HAL_FDCAN_ConfigGlobalFilter(&hfdcan2, FDCAN_REJECT, FDCAN_REJECT, FDCAN_REJECT_REMOTE, FDCAN_REJE
 134:BSP/bsp_can.c **** 	HAL_FDCAN_Start(&hfdcan2);
 135:BSP/bsp_can.c **** 	HAL_FDCAN_ActivateNotification(&hfdcan2,FDCAN_RXActiveITs, 0);
 136:BSP/bsp_can.c **** 
