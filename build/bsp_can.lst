 126:BSP/bsp_can.c **** {
 127:BSP/bsp_can.c **** #ifdef FDCAN
 128:BSP/bsp_can.c **** 	//可能不需要这么多中断
 129:BSP/bsp_can.c **** 	uint32_t FDCAN_RXActiveITs = FDCAN_IT_RX_FIFO0_NEW_MESSAGE|FDCAN_IT_RX_FIFO0_FULL\
 130:BSP/bsp_can.c **** 			|FDCAN_IT_RX_FIFO0_WATERMARK|FDCAN_IT_RX_FIFO0_MESSAGE_LOST \
 131:BSP/bsp_can.c **** 			|FDCAN_IT_RX_FIFO1_NEW_MESSAGE| FDCAN_IT_RX_FIFO1_FULL\
 132:BSP/bsp_can.c **** 			|FDCAN_IT_RX_FIFO1_WATERMARK|FDCAN_IT_RX_FIFO1_MESSAGE_LOST;
 133:BSP/bsp_can.c **** 
