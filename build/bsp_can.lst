 170:BSP/bsp_can.c ****     CANInstance *instance = (CANInstance *)malloc(sizeof(CANInstance)); // 分配空间
 171:BSP/bsp_can.c ****     memset(instance, 0, sizeof(CANInstance));                           // 分配的空间未必是
 172:BSP/bsp_can.c ****     // 进行发送报文的配置
 173:BSP/bsp_can.c **** #ifdef FDCAN
 174:BSP/bsp_can.c ****     instance->txconf.Identifier = config->tx_id; 				// 发送id
 175:BSP/bsp_can.c ****     instance->txconf.IdType = FDCAN_STANDARD_ID;  				// 使用标准id,扩展id则使用CAN_ID_EXT
 176:BSP/bsp_can.c ****     instance->txconf.TxFrameType = FDCAN_DATA_FRAME,    		// 发送数据帧
 177:BSP/bsp_can.c ****     instance->txconf.DataLength = FDCAN_DLC_BYTES_8,    		// 数据长度为8字节
 178:BSP/bsp_can.c **** 	instance->txconf.ErrorStateIndicator = FDCAN_ESI_ACTIVE,	// 兼容CAN2.0,错误状态指示器设�
 179:BSP/bsp_can.c **** 	instance->txconf.BitRateSwitch = FDCAN_BRS_OFF,         	// 兼容CAN2.0禁用位速率切换
 180:BSP/bsp_can.c **** 	instance->txconf.FDFormat = FDCAN_CLASSIC_CAN,          	// 使用经典CAN格式
 181:BSP/bsp_can.c **** 	instance->txconf.TxEventFifoControl = FDCAN_NO_TX_EVENTS,	// 不需要，禁用事件FIFO
