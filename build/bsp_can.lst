 117:BSP/bsp_can.c **** /**
 118:BSP/bsp_can.c ****  * @brief 在第一个CAN实例初始化的时候会自动调用此函数,启动CAN服务
 119:BSP/bsp_can.c ****  *
 120:BSP/bsp_can.c ****  * @note 此函数会启动CAN1并开启中断
 121:BSP/bsp_can.c ****  *       FDCAN的情况下，我们采用FIFO接收方式（而不是buffer），FIFO和buffer还�
 122:BSP/bsp_can.c ****  *       FDCAN比bxCAN多了一个全局过滤器，这里配置为全部拒绝，只接受指定ID
 123:BSP/bsp_can.c ****  *       
 124:BSP/bsp_can.c ****  */
 125:BSP/bsp_can.c **** void CANServiceInit()
 126:BSP/bsp_can.c **** {
 127:BSP/bsp_can.c **** #ifdef FDCAN
 128:BSP/bsp_can.c **** 	//可能不需要这么多中断
 129:BSP/bsp_can.c **** 	uint32_t FDCAN_RXActiveITs = FDCAN_IT_RX_FIFO0_NEW_MESSAGE|FDCAN_IT_RX_FIFO0_FULL\
 130:BSP/bsp_can.c **** 			|FDCAN_IT_RX_FIFO0_WATERMARK|FDCAN_IT_RX_FIFO0_MESSAGE_LOST \
 131:BSP/bsp_can.c **** 			|FDCAN_IT_RX_FIFO1_NEW_MESSAGE| FDCAN_IT_RX_FIFO1_FULL\
 132:BSP/bsp_can.c **** 			|FDCAN_IT_RX_FIFO1_WATERMARK|FDCAN_IT_RX_FIFO1_MESSAGE_LOST;
 133:BSP/bsp_can.c **** 
 134:BSP/bsp_can.c **** 
 135:BSP/bsp_can.c **** 	HAL_FDCAN_ConfigRxFifoOverwrite(&hfdcan2,FDCAN_RX_FIFO0,FDCAN_RX_FIFO_OVERWRITE);
 136:BSP/bsp_can.c **** 	HAL_FDCAN_ConfigRxFifoOverwrite(&hfdcan2,FDCAN_RX_FIFO1,FDCAN_RX_FIFO_OVERWRITE);
ARM GAS  D:\temp\TMP\ccuJmPdN.s 			page 6


 137:BSP/bsp_can.c **** 	HAL_FDCAN_ConfigGlobalFilter(&hfdcan2, FDCAN_REJECT, FDCAN_REJECT, FDCAN_REJECT_REMOTE, FDCAN_REJE
 138:BSP/bsp_can.c **** 	HAL_FDCAN_ConfigInterruptLines(&hfdcan2, FDCAN_RXActiveITs, FDCAN_INTERRUPT_LINE1);
