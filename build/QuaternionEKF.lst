 296:Robot/Algorithm/EKF/QuaternionEKF.c **** 
 297:Robot/Algorithm/EKF/QuaternionEKF.c ****     memset(kf->H_data, 0, sizeof_float * kf->zSize * kf->xhatSize);
 298:Robot/Algorithm/EKF/QuaternionEKF.c **** 
 299:Robot/Algorithm/EKF/QuaternionEKF.c ****     kf->H_data[0] = -doubleq2;
 300:Robot/Algorithm/EKF/QuaternionEKF.c ****     kf->H_data[1] = doubleq3;
 301:Robot/Algorithm/EKF/QuaternionEKF.c ****     kf->H_data[2] = -doubleq0;
 302:Robot/Algorithm/EKF/QuaternionEKF.c ****     kf->H_data[3] = doubleq1;
 303:Robot/Algorithm/EKF/QuaternionEKF.c **** 
 304:Robot/Algorithm/EKF/QuaternionEKF.c ****     kf->H_data[6] = doubleq1;
 305:Robot/Algorithm/EKF/QuaternionEKF.c ****     kf->H_data[7] = doubleq0;
 306:Robot/Algorithm/EKF/QuaternionEKF.c ****     kf->H_data[8] = doubleq3;
 307:Robot/Algorithm/EKF/QuaternionEKF.c ****     kf->H_data[9] = doubleq2;
 308:Robot/Algorithm/EKF/QuaternionEKF.c **** 
 309:Robot/Algorithm/EKF/QuaternionEKF.c ****     kf->H_data[12] = doubleq0;
 310:Robot/Algorithm/EKF/QuaternionEKF.c ****     kf->H_data[13] = -doubleq1;
 311:Robot/Algorithm/EKF/QuaternionEKF.c ****     kf->H_data[14] = -doubleq2;
 312:Robot/Algorithm/EKF/QuaternionEKF.c ****     kf->H_data[15] = doubleq3;
 313:Robot/Algorithm/EKF/QuaternionEKF.c **** }
