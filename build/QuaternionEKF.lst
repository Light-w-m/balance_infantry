 228:Robot/Algorithm/EKF/QuaternionEKF.c **** static void IMU_QuaternionEKF_F_Linearization_P_Fading(KalmanFilter_t *kf)
 229:Robot/Algorithm/EKF/QuaternionEKF.c **** {
 230:Robot/Algorithm/EKF/QuaternionEKF.c ****     static float q0, q1, q2, q3;
 231:Robot/Algorithm/EKF/QuaternionEKF.c ****     static float qInvNorm;
 232:Robot/Algorithm/EKF/QuaternionEKF.c **** 
 233:Robot/Algorithm/EKF/QuaternionEKF.c ****     q0 = kf->xhatminus_data[0];
 234:Robot/Algorithm/EKF/QuaternionEKF.c ****     q1 = kf->xhatminus_data[1];
 235:Robot/Algorithm/EKF/QuaternionEKF.c ****     q2 = kf->xhatminus_data[2];
 236:Robot/Algorithm/EKF/QuaternionEKF.c ****     q3 = kf->xhatminus_data[3];
 237:Robot/Algorithm/EKF/QuaternionEKF.c **** 
 238:Robot/Algorithm/EKF/QuaternionEKF.c ****     // quaternion normalize
 239:Robot/Algorithm/EKF/QuaternionEKF.c ****     qInvNorm = invSqrt(q0 * q0 + q1 * q1 + q2 * q2 + q3 * q3);
 240:Robot/Algorithm/EKF/QuaternionEKF.c ****     for (uint8_t i = 0; i < 4; i++)
 241:Robot/Algorithm/EKF/QuaternionEKF.c ****     {
 242:Robot/Algorithm/EKF/QuaternionEKF.c ****         kf->xhatminus_data[i] *= qInvNorm;
 243:Robot/Algorithm/EKF/QuaternionEKF.c ****     }
 244:Robot/Algorithm/EKF/QuaternionEKF.c ****     /*  F, number with * represent vals to be set
 245:Robot/Algorithm/EKF/QuaternionEKF.c ****      0     1     2     3     4*     5*
 246:Robot/Algorithm/EKF/QuaternionEKF.c ****      6     7     8     9    10*    11*
 247:Robot/Algorithm/EKF/QuaternionEKF.c ****     12    13    14    15    16*    17*
 248:Robot/Algorithm/EKF/QuaternionEKF.c ****     18    19    20    21    22*    23*
 249:Robot/Algorithm/EKF/QuaternionEKF.c ****     24    25    26    27    28     29
 250:Robot/Algorithm/EKF/QuaternionEKF.c ****     30    31    32    33    34     35
 251:Robot/Algorithm/EKF/QuaternionEKF.c ****     */
 252:Robot/Algorithm/EKF/QuaternionEKF.c ****     // set F
 253:Robot/Algorithm/EKF/QuaternionEKF.c ****     kf->F_data[4] = q1 * QEKF_INS.dt / 2;
 254:Robot/Algorithm/EKF/QuaternionEKF.c ****     kf->F_data[5] = q2 * QEKF_INS.dt / 2;
 255:Robot/Algorithm/EKF/QuaternionEKF.c **** 
 256:Robot/Algorithm/EKF/QuaternionEKF.c ****     kf->F_data[10] = -q0 * QEKF_INS.dt / 2;
 257:Robot/Algorithm/EKF/QuaternionEKF.c ****     kf->F_data[11] = q3 * QEKF_INS.dt / 2;
 258:Robot/Algorithm/EKF/QuaternionEKF.c **** 
