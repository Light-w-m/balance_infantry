 282:Robot/Algorithm/EKF/QuaternionEKF.c **** static void IMU_QuaternionEKF_SetH(KalmanFilter_t *kf)
 283:Robot/Algorithm/EKF/QuaternionEKF.c **** {
 284:Robot/Algorithm/EKF/QuaternionEKF.c ****     static float doubleq0, doubleq1, doubleq2, doubleq3;
 285:Robot/Algorithm/EKF/QuaternionEKF.c ****     /* H
 286:Robot/Algorithm/EKF/QuaternionEKF.c ****      0     1     2     3     4     5
 287:Robot/Algorithm/EKF/QuaternionEKF.c ****      6     7     8     9    10    11
 288:Robot/Algorithm/EKF/QuaternionEKF.c ****     12    13    14    15    16    17
 289:Robot/Algorithm/EKF/QuaternionEKF.c ****     last two cols are zero
 290:Robot/Algorithm/EKF/QuaternionEKF.c ****     */
 291:Robot/Algorithm/EKF/QuaternionEKF.c ****     // set H
 292:Robot/Algorithm/EKF/QuaternionEKF.c ****     doubleq0 = 2 * kf->xhatminus_data[0];
