 336:Robot/Algorithm/EKF/QuaternionEKF.c ****     kf->MatStatus = Matrix_Inverse(&kf->S, &kf->temp_matrix1);     // temp_matrix1 = inv(H·P'(k)·
 337:Robot/Algorithm/EKF/QuaternionEKF.c **** 
 338:Robot/Algorithm/EKF/QuaternionEKF.c ****     q0 = kf->xhatminus_data[0];
 339:Robot/Algorithm/EKF/QuaternionEKF.c ****     q1 = kf->xhatminus_data[1];
 340:Robot/Algorithm/EKF/QuaternionEKF.c ****     q2 = kf->xhatminus_data[2];
 341:Robot/Algorithm/EKF/QuaternionEKF.c ****     q3 = kf->xhatminus_data[3];
 342:Robot/Algorithm/EKF/QuaternionEKF.c **** 
