 311:Robot/Algorithm/EKF/QuaternionEKF.c **** 
 312:Robot/Algorithm/EKF/QuaternionEKF.c ****     kf->H_data[12] = doubleq0;
 313:Robot/Algorithm/EKF/QuaternionEKF.c ****     kf->H_data[13] = -doubleq1;
 314:Robot/Algorithm/EKF/QuaternionEKF.c ****     kf->H_data[14] = -doubleq2;
