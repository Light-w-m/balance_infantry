 219:Robot/Algorithm/EKF/QuaternionEKF.c **** /**
 220:Robot/Algorithm/EKF/QuaternionEKF.c ****  * @brief 用于更新线性化后的状态转移矩阵F右上角的一个4x2分块矩阵,稍后用
 221:Robot/Algorithm/EKF/QuaternionEKF.c ****  *        并对零漂的方差进行限制,防止过度收敛并限幅防止发散
 222:Robot/Algorithm/EKF/QuaternionEKF.c ****  *
 223:Robot/Algorithm/EKF/QuaternionEKF.c ****  * @param kf
 224:Robot/Algorithm/EKF/QuaternionEKF.c ****  */
 225:Robot/Algorithm/EKF/QuaternionEKF.c **** static void IMU_QuaternionEKF_F_Linearization_P_Fading(KalmanFilter_t *kf)
 226:Robot/Algorithm/EKF/QuaternionEKF.c **** {
 227:Robot/Algorithm/EKF/QuaternionEKF.c ****     static float q0, q1, q2, q3;
 228:Robot/Algorithm/EKF/QuaternionEKF.c ****     static float qInvNorm;
 229:Robot/Algorithm/EKF/QuaternionEKF.c **** 
 230:Robot/Algorithm/EKF/QuaternionEKF.c ****     q0 = kf->xhatminus_data[0];
 231:Robot/Algorithm/EKF/QuaternionEKF.c ****     q1 = kf->xhatminus_data[1];
 232:Robot/Algorithm/EKF/QuaternionEKF.c ****     q2 = kf->xhatminus_data[2];
 233:Robot/Algorithm/EKF/QuaternionEKF.c ****     q3 = kf->xhatminus_data[3];
 234:Robot/Algorithm/EKF/QuaternionEKF.c **** 
 235:Robot/Algorithm/EKF/QuaternionEKF.c ****     // quaternion normalize
 236:Robot/Algorithm/EKF/QuaternionEKF.c ****     qInvNorm = invSqrt(q0 * q0 + q1 * q1 + q2 * q2 + q3 * q3);
 237:Robot/Algorithm/EKF/QuaternionEKF.c ****     for (uint8_t i = 0; i < 4; ++i)
 238:Robot/Algorithm/EKF/QuaternionEKF.c ****     {
 239:Robot/Algorithm/EKF/QuaternionEKF.c ****         kf->xhatminus_data[i] *= qInvNorm;
 240:Robot/Algorithm/EKF/QuaternionEKF.c ****     }
 241:Robot/Algorithm/EKF/QuaternionEKF.c ****     /*  F, number with * represent vals to be set
 242:Robot/Algorithm/EKF/QuaternionEKF.c ****      0     1     2     3     4*     5*
 243:Robot/Algorithm/EKF/QuaternionEKF.c ****      6     7     8     9    10*    11*
 244:Robot/Algorithm/EKF/QuaternionEKF.c ****     12    13    14    15    16*    17*
 245:Robot/Algorithm/EKF/QuaternionEKF.c ****     18    19    20    21    22*    23*
 246:Robot/Algorithm/EKF/QuaternionEKF.c ****     24    25    26    27    28     29
 247:Robot/Algorithm/EKF/QuaternionEKF.c ****     30    31    32    33    34     35
 248:Robot/Algorithm/EKF/QuaternionEKF.c ****     */
 249:Robot/Algorithm/EKF/QuaternionEKF.c ****     // set F
 250:Robot/Algorithm/EKF/QuaternionEKF.c ****     kf->F_data[4] = q1 * QEKF_INS.dt / 2;
 251:Robot/Algorithm/EKF/QuaternionEKF.c ****     kf->F_data[5] = q2 * QEKF_INS.dt / 2;
 252:Robot/Algorithm/EKF/QuaternionEKF.c **** 
 253:Robot/Algorithm/EKF/QuaternionEKF.c ****     kf->F_data[10] = -q0 * QEKF_INS.dt / 2;
 254:Robot/Algorithm/EKF/QuaternionEKF.c ****     kf->F_data[11] = q3 * QEKF_INS.dt / 2;
 255:Robot/Algorithm/EKF/QuaternionEKF.c **** 
 256:Robot/Algorithm/EKF/QuaternionEKF.c ****     kf->F_data[16] = -q3 * QEKF_INS.dt / 2;
 257:Robot/Algorithm/EKF/QuaternionEKF.c ****     kf->F_data[17] = -q0 * QEKF_INS.dt / 2;
 258:Robot/Algorithm/EKF/QuaternionEKF.c **** 
 259:Robot/Algorithm/EKF/QuaternionEKF.c ****     kf->F_data[22] = q2 * QEKF_INS.dt / 2;
ARM GAS  D:\temp\TMP\ccF3jGGJ.s 			page 6


 260:Robot/Algorithm/EKF/QuaternionEKF.c ****     kf->F_data[23] = -q1 * QEKF_INS.dt / 2;
 261:Robot/Algorithm/EKF/QuaternionEKF.c **** 
 262:Robot/Algorithm/EKF/QuaternionEKF.c ****     // fading filter,防止零飘参数过度收敛
 263:Robot/Algorithm/EKF/QuaternionEKF.c ****     kf->P_data[28] /= QEKF_INS.lambda;
 264:Robot/Algorithm/EKF/QuaternionEKF.c ****     kf->P_data[35] /= QEKF_INS.lambda;
 265:Robot/Algorithm/EKF/QuaternionEKF.c **** 
 266:Robot/Algorithm/EKF/QuaternionEKF.c ****     // 限幅,防止发散
 267:Robot/Algorithm/EKF/QuaternionEKF.c ****     if (kf->P_data[28] > 10000)
 268:Robot/Algorithm/EKF/QuaternionEKF.c ****     {
 269:Robot/Algorithm/EKF/QuaternionEKF.c ****         kf->P_data[28] = 10000;
 270:Robot/Algorithm/EKF/QuaternionEKF.c ****     }
 271:Robot/Algorithm/EKF/QuaternionEKF.c ****     if (kf->P_data[35] > 10000)
 272:Robot/Algorithm/EKF/QuaternionEKF.c ****     {
 273:Robot/Algorithm/EKF/QuaternionEKF.c ****         kf->P_data[35] = 10000;
 274:Robot/Algorithm/EKF/QuaternionEKF.c ****     }
 275:Robot/Algorithm/EKF/QuaternionEKF.c **** }
