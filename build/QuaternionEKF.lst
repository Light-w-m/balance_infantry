 260:Robot/Algorithm/EKF/QuaternionEKF.c ****     kf->F_data[17] = -q0 * QEKF_INS.dt / 2;
 261:Robot/Algorithm/EKF/QuaternionEKF.c **** 
 262:Robot/Algorithm/EKF/QuaternionEKF.c ****     kf->F_data[22] = q2 * QEKF_INS.dt / 2;
 263:Robot/Algorithm/EKF/QuaternionEKF.c ****     kf->F_data[23] = -q1 * QEKF_INS.dt / 2;
 264:Robot/Algorithm/EKF/QuaternionEKF.c **** 
 265:Robot/Algorithm/EKF/QuaternionEKF.c ****     // fading filter,防止零飘参数过度收敛
 266:Robot/Algorithm/EKF/QuaternionEKF.c ****     kf->P_data[28] /= QEKF_INS.lambda;
