 285:Robot/Algorithm/EKF/QuaternionEKF.c **** static void IMU_QuaternionEKF_SetH(KalmanFilter_t *kf)
 286:Robot/Algorithm/EKF/QuaternionEKF.c **** {
 287:Robot/Algorithm/EKF/QuaternionEKF.c ****     static float doubleq0, doubleq1, doubleq2, doubleq3;
 288:Robot/Algorithm/EKF/QuaternionEKF.c ****     /* H
 289:Robot/Algorithm/EKF/QuaternionEKF.c ****      0     1     2     3     4     5
 290:Robot/Algorithm/EKF/QuaternionEKF.c ****      6     7     8     9    10    11
 291:Robot/Algorithm/EKF/QuaternionEKF.c ****     12    13    14    15    16    17
