 155:Robot/RoboTask/chassis/chassisR_task.c **** void RiseR_Loop(chassis_t* chassis, Leg_t* leg)
 156:Robot/RoboTask/chassis/chassisR_task.c **** {
 157:Robot/RoboTask/chassis/chassisR_task.c ****     // 用关节电机角度判断是否完成自起
 158:Robot/RoboTask/chassis/chassisR_task.c ****     if ((chassis->joint_motor[0].para.pos > 0.0f && chassis->joint_motor[0].para.pos < PI/2.0f) && 
 159:Robot/RoboTask/chassis/chassisR_task.c ****         (chassis->joint_motor[1].para.pos > -PI/2.0f && chassis->joint_motor[1].para.pos < 0.0f))
 160:Robot/RoboTask/chassis/chassisR_task.c ****         chassis->flag.recover_flag = 1;
 161:Robot/RoboTask/chassis/chassisR_task.c **** 
 162:Robot/RoboTask/chassis/chassisR_task.c ****     float diff1, diff4;
 163:Robot/RoboTask/chassis/chassisR_task.c ****     float target1 = -PI/3.0f;
 164:Robot/RoboTask/chassis/chassisR_task.c ****     float target4 = PI/3.0f;
 165:Robot/RoboTask/chassis/chassisR_task.c **** 
 166:Robot/RoboTask/chassis/chassisR_task.c ****     if (chassis->joint_motor[1].para.pos < 0 && chassis->joint_motor[0].para.pos < 0)
 167:Robot/RoboTask/chassis/chassisR_task.c ****     {
 168:Robot/RoboTask/chassis/chassisR_task.c ****         diff1 = target1 - chassis->joint_motor[1].para.pos;
 169:Robot/RoboTask/chassis/chassisR_task.c ****         diff4 = target4 - chassis->joint_motor[0].para.pos;
 170:Robot/RoboTask/chassis/chassisR_task.c ****     }
 171:Robot/RoboTask/chassis/chassisR_task.c ****     if (chassis->joint_motor[1].para.pos > 0 && chassis->joint_motor[0].para.pos > 0)
 172:Robot/RoboTask/chassis/chassisR_task.c ****     {
 173:Robot/RoboTask/chassis/chassisR_task.c ****         diff1 = target1 + 2*PI - chassis->joint_motor[1].para.pos;
 174:Robot/RoboTask/chassis/chassisR_task.c ****         diff4 = target4 + 2*PI - chassis->joint_motor[0].para.pos;
 175:Robot/RoboTask/chassis/chassisR_task.c ****     }
 176:Robot/RoboTask/chassis/chassisR_task.c ****     
 177:Robot/RoboTask/chassis/chassisR_task.c ****     if (chassis->flag.recover_flag == 0)
 178:Robot/RoboTask/chassis/chassisR_task.c ****     {
 179:Robot/RoboTask/chassis/chassisR_task.c ****         /* code */
 180:Robot/RoboTask/chassis/chassisR_task.c ****         chassis->leg_set = LEG_RISE_LENGTH_SET;
