 188:Robot/RoboTask/chassis/chassisR_task.c **** {
 189:Robot/RoboTask/chassis/chassisR_task.c ****     // 用关节电机角度判断是否完成自起
 190:Robot/RoboTask/chassis/chassisR_task.c ****     if ((chassis->joint_motor[0].para.pos > 0.0f && chassis->joint_motor[0].para.pos < PI/2.0f) && 
