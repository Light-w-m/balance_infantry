 151:Robot/RoboTask/chassis/chassisR_task.c **** void RiseR_Loop(chassis_t* chassis, Leg_t* leg)
 152:Robot/RoboTask/chassis/chassisR_task.c **** {
 153:Robot/RoboTask/chassis/chassisR_task.c ****     // 用关节电机角度判断是否完成自起
 154:Robot/RoboTask/chassis/chassisR_task.c ****     if ((chassis->joint_motor[0].para.pos > 0.0f && chassis->joint_motor[0].para.pos < PI/2.0f) && 
 155:Robot/RoboTask/chassis/chassisR_task.c ****         (chassis->joint_motor[1].para.pos > -PI/2.0f && chassis->joint_motor[1].para.pos < 0.0f))
 156:Robot/RoboTask/chassis/chassisR_task.c ****         chassis->flag.recover_flag = 1;
 157:Robot/RoboTask/chassis/chassisR_task.c **** 
 158:Robot/RoboTask/chassis/chassisR_task.c ****     float diff1, diff4;
 159:Robot/RoboTask/chassis/chassisR_task.c ****     float target1 = -PI/3.0f;
 160:Robot/RoboTask/chassis/chassisR_task.c ****     float target4 = PI/3.0f;
 161:Robot/RoboTask/chassis/chassisR_task.c **** 
 162:Robot/RoboTask/chassis/chassisR_task.c ****     if (chassis->joint_motor[1].para.pos < 0 && chassis->joint_motor[0].para.pos < 0)
 163:Robot/RoboTask/chassis/chassisR_task.c ****     {
 164:Robot/RoboTask/chassis/chassisR_task.c ****         diff1 = target1 - chassis->joint_motor[1].para.pos;
 165:Robot/RoboTask/chassis/chassisR_task.c ****         diff4 = target4 - chassis->joint_motor[0].para.pos;
 166:Robot/RoboTask/chassis/chassisR_task.c ****     }
 167:Robot/RoboTask/chassis/chassisR_task.c ****     if (chassis->joint_motor[1].para.pos > 0 && chassis->joint_motor[0].para.pos > 0)
 168:Robot/RoboTask/chassis/chassisR_task.c ****     {
 169:Robot/RoboTask/chassis/chassisR_task.c ****         diff1 = target1 + 2*PI - chassis->joint_motor[1].para.pos;
 170:Robot/RoboTask/chassis/chassisR_task.c ****         diff4 = target4 + 2*PI - chassis->joint_motor[0].para.pos;
 171:Robot/RoboTask/chassis/chassisR_task.c ****     }
 172:Robot/RoboTask/chassis/chassisR_task.c ****     
 173:Robot/RoboTask/chassis/chassisR_task.c ****     if (chassis->flag.recover_flag == 0)
 174:Robot/RoboTask/chassis/chassisR_task.c ****     {
 175:Robot/RoboTask/chassis/chassisR_task.c ****         /* code */
 176:Robot/RoboTask/chassis/chassisR_task.c ****         chassis->leg_set = LEG_RISE_LENGTH_SET;
 177:Robot/RoboTask/chassis/chassisR_task.c ****         Mit_Ctrl(&hcan1, chassis->joint_motor[0].para.id, diff4, 0.0f, 10.0f, 5.0f, 0.0f);
 178:Robot/RoboTask/chassis/chassisR_task.c ****         Mit_Ctrl(&hcan1, chassis->joint_motor[1].para.id, diff1, 0.0f, 10.0f, 5.0f, 0.0f);
 179:Robot/RoboTask/chassis/chassisR_task.c ****     }
 180:Robot/RoboTask/chassis/chassisR_task.c **** }
