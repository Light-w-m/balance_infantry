 260:Robot/RoboTask/chassis/chassisR_task.c **** /**
 261:Robot/RoboTask/chassis/chassisR_task.c ****  * @brief 位控调试模式
 262:Robot/RoboTask/chassis/chassisR_task.c ****  * 
 263:Robot/RoboTask/chassis/chassisR_task.c ****  */
 264:Robot/RoboTask/chassis/chassisR_task.c **** #ifdef ControlDebug
 265:Robot/RoboTask/chassis/chassisR_task.c **** // 保证电机逆解走最短路径
 266:Robot/RoboTask/chassis/chassisR_task.c **** 
 267:Robot/RoboTask/chassis/chassisR_task.c **** static void ChassisR_Debug(chassis_t* chassis, Leg_t* leg, Excessive_t* excessive,PidTypeDef* lengt
 268:Robot/RoboTask/chassis/chassisR_task.c **** {
 269:Robot/RoboTask/chassis/chassisR_task.c ****     // PID_Calc(length_pid, leg->rod.L0, chassis->leg_set);
 270:Robot/RoboTask/chassis/chassisR_task.c ****     InverseKinematics(chassis, leg, excessive);
 271:Robot/RoboTask/chassis/chassisR_task.c **** 
 272:Robot/RoboTask/chassis/chassisR_task.c ****     float phi1 = -PI/2.0f + leg->joint.Phi1;
 273:Robot/RoboTask/chassis/chassisR_task.c ****     float phi4 = -PI/2.0f + leg->joint.Phi4;
 274:Robot/RoboTask/chassis/chassisR_task.c **** 
 275:Robot/RoboTask/chassis/chassisR_task.c ****     // // 达妙电机，顺时针是正角度，逆时针是负角度
 276:Robot/RoboTask/chassis/chassisR_task.c ****     leg->joint.Phi1_set = ShortestAngle(phi1, &leg->joint.Phi1_set);
 277:Robot/RoboTask/chassis/chassisR_task.c ****     leg->joint.Phi4_set = ShortestAngle(phi4, &leg->joint.Phi4_set);
 278:Robot/RoboTask/chassis/chassisR_task.c **** 
 279:Robot/RoboTask/chassis/chassisR_task.c ****     //输出角度限幅
 280:Robot/RoboTask/chassis/chassisR_task.c ****     SATURATE(&leg->joint.Phi1_set, 0.0f, PI);
 281:Robot/RoboTask/chassis/chassisR_task.c ****     SATURATE(&leg->joint.Phi4_set, -PI, 0.0f);
 282:Robot/RoboTask/chassis/chassisR_task.c **** }
 283:Robot/RoboTask/chassis/chassisR_task.c **** #endif
