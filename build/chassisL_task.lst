 144:Robot/RoboTask/chassis/chassisL_task.c **** static void JumpL_Loop(chassis_t* chassis, Leg_t* leg, PidTypeDef* length_pid)
 145:Robot/RoboTask/chassis/chassisL_task.c **** {
 146:Robot/RoboTask/chassis/chassisL_task.c ****     if (chassis->flag.jump_flag == 1)
 147:Robot/RoboTask/chassis/chassisL_task.c ****     {
 148:Robot/RoboTask/chassis/chassisL_task.c ****         if (chassis->step.jump_step == NORMAL_STEP)
 149:Robot/RoboTask/chassis/chassisL_task.c ****         {
 150:Robot/RoboTask/chassis/chassisL_task.c ****             leg->rod.F0 = BODY_MASS * GRAVITY / arm_cos_f32(leg->rod.theta) / 2 
 151:Robot/RoboTask/chassis/chassisL_task.c ****                     + PID_Calc(length_pid, leg->rod.L0, MIN_LEG_LENGTH);
 152:Robot/RoboTask/chassis/chassisL_task.c ****         }
 153:Robot/RoboTask/chassis/chassisL_task.c ****         else if (chassis->step.jump_step == JUMP_STEP_SQUST)
 154:Robot/RoboTask/chassis/chassisL_task.c ****         {
 155:Robot/RoboTask/chassis/chassisL_task.c ****             leg->rod.F0 = 60.0f;
 156:Robot/RoboTask/chassis/chassisL_task.c ****         }
 157:Robot/RoboTask/chassis/chassisL_task.c ****         else if (chassis->step.jump_step == JUMP_STEP_JUMP)
 158:Robot/RoboTask/chassis/chassisL_task.c ****         {
 159:Robot/RoboTask/chassis/chassisL_task.c ****             leg->rod.F0 = BODY_MASS * GRAVITY / arm_cos_f32(leg->rod.theta) / 2 
 160:Robot/RoboTask/chassis/chassisL_task.c ****                     + PID_Calc(length_pid, leg->rod.L0, MIN_LEG_LENGTH);
 161:Robot/RoboTask/chassis/chassisL_task.c ****         }
 162:Robot/RoboTask/chassis/chassisL_task.c ****         else 
 163:Robot/RoboTask/chassis/chassisL_task.c ****             leg->rod.F0 = BODY_MASS * GRAVITY / arm_cos_f32(leg->rod.theta) / 2 
 164:Robot/RoboTask/chassis/chassisL_task.c ****                     + PID_Calc(length_pid, leg->rod.L0, chassis->leg_set);
 165:Robot/RoboTask/chassis/chassisL_task.c ****     }
 166:Robot/RoboTask/chassis/chassisL_task.c ****     else
 167:Robot/RoboTask/chassis/chassisL_task.c ****         leg->rod.F0 = BODY_MASS * GRAVITY / arm_cos_f32(leg->rod.theta) / 2 
 168:Robot/RoboTask/chassis/chassisL_task.c ****                     + PID_Calc(length_pid, leg->rod.L0, chassis->leg_set);  
