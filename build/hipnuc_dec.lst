  68:Robot/Devices/Hipnuc/hipnuc_dec.c ****         {
  69:Robot/Devices/Hipnuc/hipnuc_dec.c ****         case HIPNUC_ID_HI91:
  70:Robot/Devices/Hipnuc/hipnuc_dec.c ****         {
  71:Robot/Devices/Hipnuc/hipnuc_dec.c ****             /* code */
  72:Robot/Devices/Hipnuc/hipnuc_dec.c ****             const int size = 76;
  73:Robot/Devices/Hipnuc/hipnuc_dec.c ****             if (offset + size > raw->len)
  74:Robot/Devices/Hipnuc/hipnuc_dec.c ****             {
  75:Robot/Devices/Hipnuc/hipnuc_dec.c ****                 /* code */
  76:Robot/Devices/Hipnuc/hipnuc_dec.c ****                 return -1;
  77:Robot/Devices/Hipnuc/hipnuc_dec.c ****             }
  78:Robot/Devices/Hipnuc/hipnuc_dec.c ****             raw->hi91.tag =           HIPNUC_ID_HI91;
