 264:Robot/Algorithm/kalman/kalman_filter.c **** void Kalman_Filter_Measure(KalmanFilter_t *kf)
 265:Robot/Algorithm/kalman/kalman_filter.c **** {
 266:Robot/Algorithm/kalman/kalman_filter.c ****     // 矩阵H K R根据量测情况自动调整
 267:Robot/Algorithm/kalman/kalman_filter.c ****     // matrix H K R auto adjustment
 268:Robot/Algorithm/kalman/kalman_filter.c ****     if (kf->UseAutoAdjustment != 0)
 269:Robot/Algorithm/kalman/kalman_filter.c ****         H_K_R_Adjustment(kf);
 270:Robot/Algorithm/kalman/kalman_filter.c ****     else
