 320:Robot/Algorithm/kalman/kalman_filter.c **** void Kalman_Filter_SetK(KalmanFilter_t *kf)
 321:Robot/Algorithm/kalman/kalman_filter.c **** {
 322:Robot/Algorithm/kalman/kalman_filter.c ****     if (!kf->SkipEq3)
 323:Robot/Algorithm/kalman/kalman_filter.c ****     {
 324:Robot/Algorithm/kalman/kalman_filter.c ****         kf->MatStatus = Matrix_Transpose(&kf->H, &kf->HT); // z|x => x|z
 325:Robot/Algorithm/kalman/kalman_filter.c ****         kf->temp_matrix.numRows = kf->H.numRows;
 326:Robot/Algorithm/kalman/kalman_filter.c ****         kf->temp_matrix.numCols = kf->Pminus.numCols;
 327:Robot/Algorithm/kalman/kalman_filter.c ****         kf->MatStatus = Matrix_Multiply(&kf->H, &kf->Pminus, &kf->temp_matrix); // temp_matrix = H�
 328:Robot/Algorithm/kalman/kalman_filter.c ****         kf->temp_matrix1.numRows = kf->temp_matrix.numRows;
 329:Robot/Algorithm/kalman/kalman_filter.c ****         kf->temp_matrix1.numCols = kf->HT.numCols;
 330:Robot/Algorithm/kalman/kalman_filter.c ****         kf->MatStatus = Matrix_Multiply(&kf->temp_matrix, &kf->HT, &kf->temp_matrix1); // temp_matr
 331:Robot/Algorithm/kalman/kalman_filter.c ****         kf->S.numRows = kf->R.numRows;
 332:Robot/Algorithm/kalman/kalman_filter.c ****         kf->S.numCols = kf->R.numCols;
 333:Robot/Algorithm/kalman/kalman_filter.c ****         kf->MatStatus = Matrix_Add(&kf->temp_matrix1, &kf->R, &kf->S); // S = H P'(k) HT + R
 334:Robot/Algorithm/kalman/kalman_filter.c ****         kf->MatStatus = Matrix_Inverse(&kf->S, &kf->temp_matrix1);     // temp_matrix1 = inv(H·P'(
 335:Robot/Algorithm/kalman/kalman_filter.c ****         kf->temp_matrix.numRows = kf->Pminus.numRows;
 336:Robot/Algorithm/kalman/kalman_filter.c ****         kf->temp_matrix.numCols = kf->HT.numCols;
 337:Robot/Algorithm/kalman/kalman_filter.c ****         kf->MatStatus = Matrix_Multiply(&kf->Pminus, &kf->HT, &kf->temp_matrix); // temp_matrix = P
 338:Robot/Algorithm/kalman/kalman_filter.c ****         kf->MatStatus = Matrix_Multiply(&kf->temp_matrix, &kf->temp_matrix1, &kf->K);
 339:Robot/Algorithm/kalman/kalman_filter.c ****     }
 340:Robot/Algorithm/kalman/kalman_filter.c **** }
 341:Robot/Algorithm/kalman/kalman_filter.c **** void Kalman_Filter_xhatUpdate(KalmanFilter_t *kf)
 342:Robot/Algorithm/kalman/kalman_filter.c **** {
 343:Robot/Algorithm/kalman/kalman_filter.c ****     if (!kf->SkipEq4)
 344:Robot/Algorithm/kalman/kalman_filter.c ****     {
 345:Robot/Algorithm/kalman/kalman_filter.c ****         kf->temp_vector.numRows = kf->H.numRows;
 346:Robot/Algorithm/kalman/kalman_filter.c ****         kf->temp_vector.numCols = 1;
 347:Robot/Algorithm/kalman/kalman_filter.c ****         kf->MatStatus = Matrix_Multiply(&kf->H, &kf->xhatminus, &kf->temp_vector); // temp_vector =
 348:Robot/Algorithm/kalman/kalman_filter.c ****         kf->temp_vector1.numRows = kf->z.numRows;
 349:Robot/Algorithm/kalman/kalman_filter.c ****         kf->temp_vector1.numCols = 1;
 350:Robot/Algorithm/kalman/kalman_filter.c ****         kf->MatStatus = Matrix_Subtract(&kf->z, &kf->temp_vector, &kf->temp_vector1); // temp_vecto
 351:Robot/Algorithm/kalman/kalman_filter.c ****         kf->temp_vector.numRows = kf->K.numRows;
 352:Robot/Algorithm/kalman/kalman_filter.c ****         kf->temp_vector.numCols = 1;
 353:Robot/Algorithm/kalman/kalman_filter.c ****         kf->MatStatus = Matrix_Multiply(&kf->K, &kf->temp_vector1, &kf->temp_vector); // temp_vecto
 354:Robot/Algorithm/kalman/kalman_filter.c ****         kf->MatStatus = Matrix_Add(&kf->xhatminus, &kf->temp_vector, &kf->xhat);
 355:Robot/Algorithm/kalman/kalman_filter.c ****     }
 356:Robot/Algorithm/kalman/kalman_filter.c **** }
 357:Robot/Algorithm/kalman/kalman_filter.c **** void Kalman_Filter_P_Update(KalmanFilter_t *kf)
 358:Robot/Algorithm/kalman/kalman_filter.c **** {
 359:Robot/Algorithm/kalman/kalman_filter.c ****     if (!kf->SkipEq5)
 360:Robot/Algorithm/kalman/kalman_filter.c ****     {
 361:Robot/Algorithm/kalman/kalman_filter.c ****         kf->temp_matrix.numRows = kf->K.numRows;
 362:Robot/Algorithm/kalman/kalman_filter.c ****         kf->temp_matrix.numCols = kf->H.numCols;
 363:Robot/Algorithm/kalman/kalman_filter.c ****         kf->temp_matrix1.numRows = kf->temp_matrix.numRows;
 364:Robot/Algorithm/kalman/kalman_filter.c ****         kf->temp_matrix1.numCols = kf->Pminus.numCols;
 365:Robot/Algorithm/kalman/kalman_filter.c ****         kf->MatStatus = Matrix_Multiply(&kf->K, &kf->H, &kf->temp_matrix);                 // temp_
 366:Robot/Algorithm/kalman/kalman_filter.c ****         kf->MatStatus = Matrix_Multiply(&kf->temp_matrix, &kf->Pminus, &kf->temp_matrix1); // temp_
 367:Robot/Algorithm/kalman/kalman_filter.c ****         kf->MatStatus = Matrix_Subtract(&kf->Pminus, &kf->temp_matrix1, &kf->P);
 368:Robot/Algorithm/kalman/kalman_filter.c ****     }
 369:Robot/Algorithm/kalman/kalman_filter.c **** }
