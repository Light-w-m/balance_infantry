 319:Robot/Algorithm/kalman/kalman_filter.c ****         kf->MatStatus = Matrix_Multiply(&kf->H, &kf->Pminus, &kf->temp_matrix); // temp_matrix = H�
 320:Robot/Algorithm/kalman/kalman_filter.c ****         kf->temp_matrix1.numRows = kf->temp_matrix.numRows;
 321:Robot/Algorithm/kalman/kalman_filter.c ****         kf->temp_matrix1.numCols = kf->HT.numCols;
 322:Robot/Algorithm/kalman/kalman_filter.c ****         kf->MatStatus = Matrix_Multiply(&kf->temp_matrix, &kf->HT, &kf->temp_matrix1); // temp_matr
 323:Robot/Algorithm/kalman/kalman_filter.c ****         kf->S.numRows = kf->R.numRows;
 324:Robot/Algorithm/kalman/kalman_filter.c ****         kf->S.numCols = kf->R.numCols;
 325:Robot/Algorithm/kalman/kalman_filter.c ****         kf->MatStatus = Matrix_Add(&kf->temp_matrix1, &kf->R, &kf->S); // S = H P'(k) HT + R
 326:Robot/Algorithm/kalman/kalman_filter.c ****         kf->MatStatus = Matrix_Inverse(&kf->S, &kf->temp_matrix1);     // temp_matrix1 = inv(H·P'(
 327:Robot/Algorithm/kalman/kalman_filter.c ****         kf->temp_matrix.numRows = kf->Pminus.numRows;
 328:Robot/Algorithm/kalman/kalman_filter.c ****         kf->temp_matrix.numCols = kf->HT.numCols;
 329:Robot/Algorithm/kalman/kalman_filter.c ****         kf->MatStatus = Matrix_Multiply(&kf->Pminus, &kf->HT, &kf->temp_matrix); // temp_matrix = P
 330:Robot/Algorithm/kalman/kalman_filter.c ****         kf->MatStatus = Matrix_Multiply(&kf->temp_matrix, &kf->temp_matrix1, &kf->K);
 331:Robot/Algorithm/kalman/kalman_filter.c ****     }
 332:Robot/Algorithm/kalman/kalman_filter.c **** }
 333:Robot/Algorithm/kalman/kalman_filter.c **** void Kalman_Filter_xhatUpdate(KalmanFilter_t *kf)
 334:Robot/Algorithm/kalman/kalman_filter.c **** {
 335:Robot/Algorithm/kalman/kalman_filter.c ****     if (!kf->SkipEq4)
 336:Robot/Algorithm/kalman/kalman_filter.c ****     {
 337:Robot/Algorithm/kalman/kalman_filter.c ****         kf->temp_vector.numRows = kf->H.numRows;
 338:Robot/Algorithm/kalman/kalman_filter.c ****         kf->temp_vector.numCols = 1;
 339:Robot/Algorithm/kalman/kalman_filter.c ****         kf->MatStatus = Matrix_Multiply(&kf->H, &kf->xhatminus, &kf->temp_vector); // temp_vector =
 340:Robot/Algorithm/kalman/kalman_filter.c ****         kf->temp_vector1.numRows = kf->z.numRows;
 341:Robot/Algorithm/kalman/kalman_filter.c ****         kf->temp_vector1.numCols = 1;
 342:Robot/Algorithm/kalman/kalman_filter.c ****         kf->MatStatus = Matrix_Subtract(&kf->z, &kf->temp_vector, &kf->temp_vector1); // temp_vecto
 343:Robot/Algorithm/kalman/kalman_filter.c ****         kf->temp_vector.numRows = kf->K.numRows;
 344:Robot/Algorithm/kalman/kalman_filter.c ****         kf->temp_vector.numCols = 1;
 345:Robot/Algorithm/kalman/kalman_filter.c ****         kf->MatStatus = Matrix_Multiply(&kf->K, &kf->temp_vector1, &kf->temp_vector); // temp_vecto
 346:Robot/Algorithm/kalman/kalman_filter.c ****         kf->MatStatus = Matrix_Add(&kf->xhatminus, &kf->temp_vector, &kf->xhat);
 347:Robot/Algorithm/kalman/kalman_filter.c ****     }
 348:Robot/Algorithm/kalman/kalman_filter.c **** }
 349:Robot/Algorithm/kalman/kalman_filter.c **** void Kalman_Filter_P_Update(KalmanFilter_t *kf)
 350:Robot/Algorithm/kalman/kalman_filter.c **** {
 351:Robot/Algorithm/kalman/kalman_filter.c ****     if (!kf->SkipEq5)
 352:Robot/Algorithm/kalman/kalman_filter.c ****     {
 353:Robot/Algorithm/kalman/kalman_filter.c ****         kf->temp_matrix.numRows = kf->K.numRows;
 354:Robot/Algorithm/kalman/kalman_filter.c ****         kf->temp_matrix.numCols = kf->H.numCols;
 355:Robot/Algorithm/kalman/kalman_filter.c ****         kf->temp_matrix1.numRows = kf->temp_matrix.numRows;
 356:Robot/Algorithm/kalman/kalman_filter.c ****         kf->temp_matrix1.numCols = kf->Pminus.numCols;
 357:Robot/Algorithm/kalman/kalman_filter.c ****         kf->MatStatus = Matrix_Multiply(&kf->K, &kf->H, &kf->temp_matrix);                 // temp_
 358:Robot/Algorithm/kalman/kalman_filter.c ****         kf->MatStatus = Matrix_Multiply(&kf->temp_matrix, &kf->Pminus, &kf->temp_matrix1); // temp_
 359:Robot/Algorithm/kalman/kalman_filter.c ****         kf->MatStatus = Matrix_Subtract(&kf->Pminus, &kf->temp_matrix1, &kf->P);
