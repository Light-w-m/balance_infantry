 363:Robot/Algorithm/kalman/kalman_filter.c **** /**
 364:Robot/Algorithm/kalman/kalman_filter.c ****  * @brief 执行卡尔曼滤波黄金五式,提供了用户定义函数,可以替代五个中的任
 365:Robot/Algorithm/kalman/kalman_filter.c ****  * 
 366:Robot/Algorithm/kalman/kalman_filter.c ****  * @param kf kf类型定义
 367:Robot/Algorithm/kalman/kalman_filter.c ****  * @return float* 返回滤波值
 368:Robot/Algorithm/kalman/kalman_filter.c ****  */
 369:Robot/Algorithm/kalman/kalman_filter.c **** float *Kalman_Filter_Update(KalmanFilter_t *kf)
 370:Robot/Algorithm/kalman/kalman_filter.c **** {
 371:Robot/Algorithm/kalman/kalman_filter.c ****     // 0. 获取量测信息
 372:Robot/Algorithm/kalman/kalman_filter.c ****     Kalman_Filter_Measure(kf);
 373:Robot/Algorithm/kalman/kalman_filter.c ****     if (kf->User_Func0_f != NULL)
ARM GAS  D:\temp\TMP\ccu2GakD.s 			page 8


 374:Robot/Algorithm/kalman/kalman_filter.c ****         kf->User_Func0_f(kf);
 375:Robot/Algorithm/kalman/kalman_filter.c **** 
 376:Robot/Algorithm/kalman/kalman_filter.c ****     // 先验估计
 377:Robot/Algorithm/kalman/kalman_filter.c ****     // 1. xhat'(k)= A·xhat(k-1) + B·u
 378:Robot/Algorithm/kalman/kalman_filter.c ****     Kalman_Filter_xhatMinusUpdate(kf);
 379:Robot/Algorithm/kalman/kalman_filter.c ****     if (kf->User_Func1_f != NULL)
 380:Robot/Algorithm/kalman/kalman_filter.c ****         kf->User_Func1_f(kf);
 381:Robot/Algorithm/kalman/kalman_filter.c **** 
 382:Robot/Algorithm/kalman/kalman_filter.c ****     // 预测更新
 383:Robot/Algorithm/kalman/kalman_filter.c ****     // 2. P'(k) = A·P(k-1)·AT + Q
 384:Robot/Algorithm/kalman/kalman_filter.c ****     Kalman_Filter_PminusUpdate(kf);
 385:Robot/Algorithm/kalman/kalman_filter.c ****     if (kf->User_Func2_f != NULL)
 386:Robot/Algorithm/kalman/kalman_filter.c ****         kf->User_Func2_f(kf);
 387:Robot/Algorithm/kalman/kalman_filter.c **** 
 388:Robot/Algorithm/kalman/kalman_filter.c ****     if (kf->MeasurementValidNum != 0 || kf->UseAutoAdjustment == 0)
 389:Robot/Algorithm/kalman/kalman_filter.c ****     {
 390:Robot/Algorithm/kalman/kalman_filter.c ****         // 量测更新
 391:Robot/Algorithm/kalman/kalman_filter.c ****         // 3. K(k) = P'(k)·HT / (H·P'(k)·HT + R)
 392:Robot/Algorithm/kalman/kalman_filter.c ****         Kalman_Filter_SetK(kf);
 393:Robot/Algorithm/kalman/kalman_filter.c **** 
 394:Robot/Algorithm/kalman/kalman_filter.c ****         if (kf->User_Func3_f != NULL)
 395:Robot/Algorithm/kalman/kalman_filter.c ****             kf->User_Func3_f(kf);
 396:Robot/Algorithm/kalman/kalman_filter.c **** 
 397:Robot/Algorithm/kalman/kalman_filter.c ****         // 融合
 398:Robot/Algorithm/kalman/kalman_filter.c ****         // 4. xhat(k) = xhat'(k) + K(k)·(z(k) - H·xhat'(k))
 399:Robot/Algorithm/kalman/kalman_filter.c ****         Kalman_Filter_xhatUpdate(kf);
 400:Robot/Algorithm/kalman/kalman_filter.c **** 
 401:Robot/Algorithm/kalman/kalman_filter.c ****         if (kf->User_Func4_f != NULL)
 402:Robot/Algorithm/kalman/kalman_filter.c ****             kf->User_Func4_f(kf);
 403:Robot/Algorithm/kalman/kalman_filter.c **** 
 404:Robot/Algorithm/kalman/kalman_filter.c ****         // 修正方差
 405:Robot/Algorithm/kalman/kalman_filter.c ****         // 5. P(k) = (1-K(k)·H)·P'(k) ==> P(k) = P'(k)-K(k)·H·P'(k)
 406:Robot/Algorithm/kalman/kalman_filter.c ****         Kalman_Filter_P_Update(kf);
 407:Robot/Algorithm/kalman/kalman_filter.c ****     }
 408:Robot/Algorithm/kalman/kalman_filter.c ****     else
 409:Robot/Algorithm/kalman/kalman_filter.c ****     {
 410:Robot/Algorithm/kalman/kalman_filter.c ****         // 无有效量测,仅预测
 411:Robot/Algorithm/kalman/kalman_filter.c ****         // xhat(k) = xhat'(k)
 412:Robot/Algorithm/kalman/kalman_filter.c ****         // P(k) = P'(k)
 413:Robot/Algorithm/kalman/kalman_filter.c ****         memcpy(kf->xhat_data, kf->xhatminus_data, sizeof_float * kf->xhatSize);
 414:Robot/Algorithm/kalman/kalman_filter.c ****         memcpy(kf->P_data, kf->Pminus_data, sizeof_float * kf->xhatSize * kf->xhatSize);
 415:Robot/Algorithm/kalman/kalman_filter.c ****     }
 416:Robot/Algorithm/kalman/kalman_filter.c **** 
 417:Robot/Algorithm/kalman/kalman_filter.c ****     // 自定义函数,可以提供后处理等
 418:Robot/Algorithm/kalman/kalman_filter.c ****     if (kf->User_Func5_f != NULL)
 419:Robot/Algorithm/kalman/kalman_filter.c ****         kf->User_Func5_f(kf);
 420:Robot/Algorithm/kalman/kalman_filter.c **** 
 421:Robot/Algorithm/kalman/kalman_filter.c ****     // 避免滤波器过度收敛
 422:Robot/Algorithm/kalman/kalman_filter.c ****     // suppress filter excessive convergence
 423:Robot/Algorithm/kalman/kalman_filter.c ****     for (uint8_t i = 0; i < kf->xhatSize; ++i)
 424:Robot/Algorithm/kalman/kalman_filter.c ****     {
 425:Robot/Algorithm/kalman/kalman_filter.c ****         if (kf->P_data[i * kf->xhatSize + i] < kf->StateMinVariance[i])
 426:Robot/Algorithm/kalman/kalman_filter.c ****             kf->P_data[i * kf->xhatSize + i] = kf->StateMinVariance[i];
 427:Robot/Algorithm/kalman/kalman_filter.c ****     }
 428:Robot/Algorithm/kalman/kalman_filter.c **** 
 429:Robot/Algorithm/kalman/kalman_filter.c ****     memcpy(kf->FilteredValue, kf->xhat_data, sizeof_float * kf->xhatSize);
 430:Robot/Algorithm/kalman/kalman_filter.c **** 
ARM GAS  D:\temp\TMP\ccu2GakD.s 			page 9


 431:Robot/Algorithm/kalman/kalman_filter.c ****     if (kf->User_Func6_f != NULL)
 432:Robot/Algorithm/kalman/kalman_filter.c ****         kf->User_Func6_f(kf);
 433:Robot/Algorithm/kalman/kalman_filter.c **** 
 434:Robot/Algorithm/kalman/kalman_filter.c ****     return kf->FilteredValue;
 435:Robot/Algorithm/kalman/kalman_filter.c **** }
