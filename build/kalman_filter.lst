 371:Robot/Algorithm/kalman/kalman_filter.c **** /**
 372:Robot/Algorithm/kalman/kalman_filter.c ****  * @brief 执行卡尔曼滤波黄金五式,提供了用户定义函数,可以替代五个中的任
 373:Robot/Algorithm/kalman/kalman_filter.c ****  * 
ARM GAS  D:\temp\TMP\ccucMPkF.s 			page 8


 374:Robot/Algorithm/kalman/kalman_filter.c ****  * @param kf kf类型定义
 375:Robot/Algorithm/kalman/kalman_filter.c ****  * @return float* 返回滤波值
 376:Robot/Algorithm/kalman/kalman_filter.c ****  */
 377:Robot/Algorithm/kalman/kalman_filter.c **** float *Kalman_Filter_Update(KalmanFilter_t *kf)
 378:Robot/Algorithm/kalman/kalman_filter.c **** {
 379:Robot/Algorithm/kalman/kalman_filter.c ****     // 0. 获取量测信息
 380:Robot/Algorithm/kalman/kalman_filter.c ****     Kalman_Filter_Measure(kf);
 381:Robot/Algorithm/kalman/kalman_filter.c ****     if (kf->User_Func0_f != NULL)
 382:Robot/Algorithm/kalman/kalman_filter.c ****         kf->User_Func0_f(kf);
 383:Robot/Algorithm/kalman/kalman_filter.c **** 
 384:Robot/Algorithm/kalman/kalman_filter.c ****     // 先验估计
 385:Robot/Algorithm/kalman/kalman_filter.c ****     // 1. xhat'(k)= A·xhat(k-1) + B·u
 386:Robot/Algorithm/kalman/kalman_filter.c ****     Kalman_Filter_xhatMinusUpdate(kf);
 387:Robot/Algorithm/kalman/kalman_filter.c ****     if (kf->User_Func1_f != NULL)
 388:Robot/Algorithm/kalman/kalman_filter.c ****         kf->User_Func1_f(kf);
 389:Robot/Algorithm/kalman/kalman_filter.c **** 
 390:Robot/Algorithm/kalman/kalman_filter.c ****     // 预测更新
 391:Robot/Algorithm/kalman/kalman_filter.c ****     // 2. P'(k) = A·P(k-1)·AT + Q
 392:Robot/Algorithm/kalman/kalman_filter.c ****     Kalman_Filter_PminusUpdate(kf);
 393:Robot/Algorithm/kalman/kalman_filter.c ****     if (kf->User_Func2_f != NULL)
 394:Robot/Algorithm/kalman/kalman_filter.c ****         kf->User_Func2_f(kf);
 395:Robot/Algorithm/kalman/kalman_filter.c **** 
 396:Robot/Algorithm/kalman/kalman_filter.c ****     if (kf->MeasurementValidNum != 0 || kf->UseAutoAdjustment == 0)
 397:Robot/Algorithm/kalman/kalman_filter.c ****     {
 398:Robot/Algorithm/kalman/kalman_filter.c ****         // 量测更新
 399:Robot/Algorithm/kalman/kalman_filter.c ****         // 3. K(k) = P'(k)·HT / (H·P'(k)·HT + R)
 400:Robot/Algorithm/kalman/kalman_filter.c ****         Kalman_Filter_SetK(kf);
 401:Robot/Algorithm/kalman/kalman_filter.c **** 
 402:Robot/Algorithm/kalman/kalman_filter.c ****         if (kf->User_Func3_f != NULL)
 403:Robot/Algorithm/kalman/kalman_filter.c ****             kf->User_Func3_f(kf);
 404:Robot/Algorithm/kalman/kalman_filter.c **** 
 405:Robot/Algorithm/kalman/kalman_filter.c ****         // 融合
 406:Robot/Algorithm/kalman/kalman_filter.c ****         // 4. xhat(k) = xhat'(k) + K(k)·(z(k) - H·xhat'(k))
 407:Robot/Algorithm/kalman/kalman_filter.c ****         Kalman_Filter_xhatUpdate(kf);
 408:Robot/Algorithm/kalman/kalman_filter.c **** 
 409:Robot/Algorithm/kalman/kalman_filter.c ****         if (kf->User_Func4_f != NULL)
 410:Robot/Algorithm/kalman/kalman_filter.c ****             kf->User_Func4_f(kf);
 411:Robot/Algorithm/kalman/kalman_filter.c **** 
 412:Robot/Algorithm/kalman/kalman_filter.c ****         // 修正方差
 413:Robot/Algorithm/kalman/kalman_filter.c ****         // 5. P(k) = (1-K(k)·H)·P'(k) ==> P(k) = P'(k)-K(k)·H·P'(k)
 414:Robot/Algorithm/kalman/kalman_filter.c ****         Kalman_Filter_P_Update(kf);
 415:Robot/Algorithm/kalman/kalman_filter.c ****     }
 416:Robot/Algorithm/kalman/kalman_filter.c ****     else
 417:Robot/Algorithm/kalman/kalman_filter.c ****     {
 418:Robot/Algorithm/kalman/kalman_filter.c ****         // 无有效量测,仅预测
 419:Robot/Algorithm/kalman/kalman_filter.c ****         // xhat(k) = xhat'(k)
 420:Robot/Algorithm/kalman/kalman_filter.c ****         // P(k) = P'(k)
 421:Robot/Algorithm/kalman/kalman_filter.c ****         memcpy(kf->xhat_data, kf->xhatminus_data, sizeof_float * kf->xhatSize);
 422:Robot/Algorithm/kalman/kalman_filter.c ****         memcpy(kf->P_data, kf->Pminus_data, sizeof_float * kf->xhatSize * kf->xhatSize);
 423:Robot/Algorithm/kalman/kalman_filter.c ****     }
 424:Robot/Algorithm/kalman/kalman_filter.c **** 
 425:Robot/Algorithm/kalman/kalman_filter.c ****     // 自定义函数,可以提供后处理等
 426:Robot/Algorithm/kalman/kalman_filter.c ****     if (kf->User_Func5_f != NULL)
 427:Robot/Algorithm/kalman/kalman_filter.c ****         kf->User_Func5_f(kf);
 428:Robot/Algorithm/kalman/kalman_filter.c **** 
 429:Robot/Algorithm/kalman/kalman_filter.c ****     // 避免滤波器过度收敛
 430:Robot/Algorithm/kalman/kalman_filter.c ****     // suppress filter excessive convergence
ARM GAS  D:\temp\TMP\ccucMPkF.s 			page 9


 431:Robot/Algorithm/kalman/kalman_filter.c ****     for (uint8_t i = 0; i < kf->xhatSize; i++)
 432:Robot/Algorithm/kalman/kalman_filter.c ****     {
 433:Robot/Algorithm/kalman/kalman_filter.c ****         if (kf->P_data[i * kf->xhatSize + i] < kf->StateMinVariance[i])
 434:Robot/Algorithm/kalman/kalman_filter.c ****             kf->P_data[i * kf->xhatSize + i] = kf->StateMinVariance[i];
 435:Robot/Algorithm/kalman/kalman_filter.c ****     }
 436:Robot/Algorithm/kalman/kalman_filter.c **** 
 437:Robot/Algorithm/kalman/kalman_filter.c ****     memcpy(kf->FilteredValue, kf->xhat_data, sizeof_float * kf->xhatSize);
 438:Robot/Algorithm/kalman/kalman_filter.c **** 
 439:Robot/Algorithm/kalman/kalman_filter.c ****     if (kf->User_Func6_f != NULL)
 440:Robot/Algorithm/kalman/kalman_filter.c ****         kf->User_Func6_f(kf);
 441:Robot/Algorithm/kalman/kalman_filter.c **** 
 442:Robot/Algorithm/kalman/kalman_filter.c ****     return kf->FilteredValue;
 443:Robot/Algorithm/kalman/kalman_filter.c **** }
