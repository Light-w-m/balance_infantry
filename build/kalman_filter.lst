 279:Robot/Algorithm/kalman/kalman_filter.c **** void Kalman_Filter_xhatMinusUpdate(KalmanFilter_t *kf)
 280:Robot/Algorithm/kalman/kalman_filter.c **** {
 281:Robot/Algorithm/kalman/kalman_filter.c ****     if (!kf->SkipEq1)
 282:Robot/Algorithm/kalman/kalman_filter.c ****     {
 283:Robot/Algorithm/kalman/kalman_filter.c ****         if (kf->uSize > 0)
 284:Robot/Algorithm/kalman/kalman_filter.c ****         {
 285:Robot/Algorithm/kalman/kalman_filter.c ****             kf->temp_vector.numRows = kf->xhatSize;
 286:Robot/Algorithm/kalman/kalman_filter.c ****             kf->temp_vector.numCols = 1;
 287:Robot/Algorithm/kalman/kalman_filter.c ****             kf->MatStatus = Matrix_Multiply(&kf->F, &kf->xhat, &kf->temp_vector);
 288:Robot/Algorithm/kalman/kalman_filter.c ****             kf->temp_vector1.numRows = kf->xhatSize;
 289:Robot/Algorithm/kalman/kalman_filter.c ****             kf->temp_vector1.numCols = 1;
 290:Robot/Algorithm/kalman/kalman_filter.c ****             kf->MatStatus = Matrix_Multiply(&kf->B, &kf->u, &kf->temp_vector1);
 291:Robot/Algorithm/kalman/kalman_filter.c ****             kf->MatStatus = Matrix_Add(&kf->temp_vector, &kf->temp_vector1, &kf->xhatminus);
 292:Robot/Algorithm/kalman/kalman_filter.c ****         }
 293:Robot/Algorithm/kalman/kalman_filter.c ****         else
 294:Robot/Algorithm/kalman/kalman_filter.c ****         {
 295:Robot/Algorithm/kalman/kalman_filter.c ****             kf->MatStatus = Matrix_Multiply(&kf->F, &kf->xhat, &kf->xhatminus);
 296:Robot/Algorithm/kalman/kalman_filter.c ****         }
 297:Robot/Algorithm/kalman/kalman_filter.c ****     }
 298:Robot/Algorithm/kalman/kalman_filter.c **** }
 299:Robot/Algorithm/kalman/kalman_filter.c **** 
 300:Robot/Algorithm/kalman/kalman_filter.c **** void Kalman_Filter_PminusUpdate(KalmanFilter_t *kf)
 301:Robot/Algorithm/kalman/kalman_filter.c **** {
 302:Robot/Algorithm/kalman/kalman_filter.c ****     if (!kf->SkipEq2)
 303:Robot/Algorithm/kalman/kalman_filter.c ****     {
 304:Robot/Algorithm/kalman/kalman_filter.c ****         kf->MatStatus = Matrix_Transpose(&kf->F, &kf->FT);
 305:Robot/Algorithm/kalman/kalman_filter.c ****         kf->MatStatus = Matrix_Multiply(&kf->F, &kf->P, &kf->Pminus);
 306:Robot/Algorithm/kalman/kalman_filter.c ****         kf->temp_matrix.numRows = kf->Pminus.numRows;
 307:Robot/Algorithm/kalman/kalman_filter.c ****         kf->temp_matrix.numCols = kf->FT.numCols;
 308:Robot/Algorithm/kalman/kalman_filter.c ****         kf->MatStatus = Matrix_Multiply(&kf->Pminus, &kf->FT, &kf->temp_matrix); // temp_matrix = F
 309:Robot/Algorithm/kalman/kalman_filter.c ****         kf->MatStatus = Matrix_Add(&kf->temp_matrix, &kf->Q, &kf->Pminus);
 310:Robot/Algorithm/kalman/kalman_filter.c ****     }
 311:Robot/Algorithm/kalman/kalman_filter.c **** }
 312:Robot/Algorithm/kalman/kalman_filter.c **** void Kalman_Filter_SetK(KalmanFilter_t *kf)
 313:Robot/Algorithm/kalman/kalman_filter.c **** {
 314:Robot/Algorithm/kalman/kalman_filter.c ****     if (!kf->SkipEq3)
 315:Robot/Algorithm/kalman/kalman_filter.c ****     {
 316:Robot/Algorithm/kalman/kalman_filter.c ****         kf->MatStatus = Matrix_Transpose(&kf->H, &kf->HT); // z|x => x|z
ARM GAS  D:\temp\TMP\ccu2GakD.s 			page 7


 317:Robot/Algorithm/kalman/kalman_filter.c ****         kf->temp_matrix.numRows = kf->H.numRows;
