 308:Robot/Algorithm/kalman/kalman_filter.c **** void Kalman_Filter_PminusUpdate(KalmanFilter_t *kf)
 309:Robot/Algorithm/kalman/kalman_filter.c **** {
 310:Robot/Algorithm/kalman/kalman_filter.c ****     if (!kf->SkipEq2)
 311:Robot/Algorithm/kalman/kalman_filter.c ****     {
 312:Robot/Algorithm/kalman/kalman_filter.c ****         kf->MatStatus = Matrix_Transpose(&kf->F, &kf->FT);
 313:Robot/Algorithm/kalman/kalman_filter.c ****         kf->MatStatus = Matrix_Multiply(&kf->F, &kf->P, &kf->Pminus);
 314:Robot/Algorithm/kalman/kalman_filter.c ****         kf->temp_matrix.numRows = kf->Pminus.numRows;
 315:Robot/Algorithm/kalman/kalman_filter.c ****         kf->temp_matrix.numCols = kf->FT.numCols;
