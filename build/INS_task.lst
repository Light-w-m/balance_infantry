 241:Robot/RoboTask/ins/ins_task.c ****     init_q4[0] = cosf(angle / 2.0f);
 242:Robot/RoboTask/ins/ins_task.c ****     for (uint8_t i = 0; i < 2; ++i)
 243:Robot/RoboTask/ins/ins_task.c ****         init_q4[i + 1] = axis_rot[i] * sinf(angle / 2.0f); // 轴角公式,第三轴为0(没有z轴
 244:Robot/RoboTask/ins/ins_task.c **** }
