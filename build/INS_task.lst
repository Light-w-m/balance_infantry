  66:Robot/RoboTask/ins/ins_task.c **** static void IMU_Temperature_Ctrl(void)
  67:Robot/RoboTask/ins/ins_task.c **** {
  68:Robot/RoboTask/ins/ins_task.c ****     PIDCalculate(&TempCtrl, BMI088.Temperature, RefTemp);
  69:Robot/RoboTask/ins/ins_task.c ****     IMUPWMSet(float_constrain(float_rounding(TempCtrl.Output), 0, UINT32_MAX));
  70:Robot/RoboTask/ins/ins_task.c **** }
  71:Robot/RoboTask/ins/ins_task.c **** 
  72:Robot/RoboTask/ins/ins_task.c **** // 使用加速度计的数据初始化Roll和Pitch,而Yaw置0,这样可以避免在初始时候的
  73:Robot/RoboTask/ins/ins_task.c **** static void InitQuaternion(float *init_q4)
  74:Robot/RoboTask/ins/ins_task.c **** {
  75:Robot/RoboTask/ins/ins_task.c ****     float acc_init[3] = {0};
  76:Robot/RoboTask/ins/ins_task.c ****     float gravity_norm[3] = {0, 0, 1}; // 导航系重力加速度矢量,归一化后为(0,0,1)
  77:Robot/RoboTask/ins/ins_task.c ****     float axis_rot[3] = {0};           // 旋转轴
  78:Robot/RoboTask/ins/ins_task.c ****     // 读取100次加速度计数据,取平均值作为初始值
  79:Robot/RoboTask/ins/ins_task.c ****     for (uint8_t i = 0; i < 100; ++i)
  80:Robot/RoboTask/ins/ins_task.c ****     {
  81:Robot/RoboTask/ins/ins_task.c ****         BMI088_Read(&BMI088);
  82:Robot/RoboTask/ins/ins_task.c ****         acc_init[X_AXIS] += BMI088.Accel[X_AXIS];
  83:Robot/RoboTask/ins/ins_task.c ****         acc_init[Y_AXIS] += BMI088.Accel[Y_AXIS];
  84:Robot/RoboTask/ins/ins_task.c ****         acc_init[Z_AXIS] += BMI088.Accel[Z_AXIS];
  85:Robot/RoboTask/ins/ins_task.c ****         DWT_Delay(0.001);
  86:Robot/RoboTask/ins/ins_task.c ****     }
  87:Robot/RoboTask/ins/ins_task.c ****     for (uint8_t i = 0; i < 3; ++i)
  88:Robot/RoboTask/ins/ins_task.c ****         acc_init[i] /= 100;
