  89:Robot/RoboTask/ins/ins_task.c ****     Norm3d(acc_init);
  90:Robot/RoboTask/ins/ins_task.c ****     // 计算原始加速度矢量和导航系重力加速度矢量的夹角
  91:Robot/RoboTask/ins/ins_task.c ****     float angle = acosf(Dot3d(acc_init, gravity_norm));
  92:Robot/RoboTask/ins/ins_task.c ****     Cross3d(acc_init, gravity_norm, axis_rot);
  93:Robot/RoboTask/ins/ins_task.c ****     Norm3d(axis_rot);
  94:Robot/RoboTask/ins/ins_task.c ****     init_q4[0] = cosf(angle / 2.0f);
  95:Robot/RoboTask/ins/ins_task.c ****     for (uint8_t i = 0; i < 2; ++i)
  96:Robot/RoboTask/ins/ins_task.c ****         init_q4[i + 1] = axis_rot[i] * sinf(angle / 2.0f); // 轴角公式,第三轴为0(没有z轴
  97:Robot/RoboTask/ins/ins_task.c **** }
