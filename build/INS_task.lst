 223:Robot/RoboTask/ins/ins_task.c ****     float gravity_norm[3] = {0, 0, 1}; // 导航系重力加速度矢量,归一化后为(0,0,1)
 224:Robot/RoboTask/ins/ins_task.c ****     float axis_rot[3] = {0};           // 旋转轴
 225:Robot/RoboTask/ins/ins_task.c ****     // 读取100次加速度计数据,取平均值作为初始值
 226:Robot/RoboTask/ins/ins_task.c ****     for (uint8_t i = 0; i < 100; ++i)
 227:Robot/RoboTask/ins/ins_task.c ****     {
