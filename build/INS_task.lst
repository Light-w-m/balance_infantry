 312:Robot/RoboTask/ins/ins_task.c **** 		Gyro.x = HIPNUC.hi91.gyro[X_AXIS];
 313:Robot/RoboTask/ins/ins_task.c **** 		Gyro.y = HIPNUC.hi91.gyro[Y_AXIS];
 314:Robot/RoboTask/ins/ins_task.c **** 		Gyro.z = HIPNUC.hi91.gyro[Z_AXIS];
 315:Robot/RoboTask/ins/ins_task.c **** 
 316:Robot/RoboTask/ins/ins_task.c **** 		mahony_input(&mahony,Gyro,Accel);
 317:Robot/RoboTask/ins/ins_task.c **** 		mahony_update(&mahony);
 318:Robot/RoboTask/ins/ins_task.c **** 		mahony_output(&mahony);
 319:Robot/RoboTask/ins/ins_task.c **** 	  	RotationMatrix_update(&mahony);
 320:Robot/RoboTask/ins/ins_task.c **** 
 321:Robot/RoboTask/ins/ins_task.c **** 		INS.q[0]=mahony.q0;
 322:Robot/RoboTask/ins/ins_task.c **** 		INS.q[1]=mahony.q1;
 323:Robot/RoboTask/ins/ins_task.c **** 		INS.q[2]=mahony.q2;
 324:Robot/RoboTask/ins/ins_task.c **** 		INS.q[3]=mahony.q3;
 325:Robot/RoboTask/ins/ins_task.c **** 
 326:Robot/RoboTask/ins/ins_task.c **** 		// 将重力从导航坐标系n转换到机体系b,随后根据加速度计数据计算运动加�
 327:Robot/RoboTask/ins/ins_task.c **** 		float gravity_b[3];
 328:Robot/RoboTask/ins/ins_task.c **** 		EarthFrameToBodyFrame(gravity, gravity_b, INS.q);
 329:Robot/RoboTask/ins/ins_task.c **** 		for (uint8_t i = 0; i < 3; i++) // 同样过一个低通滤波
 330:Robot/RoboTask/ins/ins_task.c **** 		{
 331:Robot/RoboTask/ins/ins_task.c **** 			INS.MotionAccel_b[i] = (INS.Accel[i] - gravity_b[i]) * ins_dt / (INS.AccelLPF + ins_dt) 
 332:Robot/RoboTask/ins/ins_task.c **** 															+ INS.MotionAccel_b[i] * INS.AccelLPF / (INS.AccelLPF + ins_dt); 
 333:Robot/RoboTask/ins/ins_task.c **** 		}
 334:Robot/RoboTask/ins/ins_task.c **** 		BodyFrameToEarthFrame(INS.MotionAccel_b, INS.MotionAccel_n, INS.q); // 转换回导航系n
ARM GAS  D:\temp\TMP\ccqm8Xmv.s 			page 13


 335:Robot/RoboTask/ins/ins_task.c **** 
 336:Robot/RoboTask/ins/ins_task.c **** 		//死区处理
 337:Robot/RoboTask/ins/ins_task.c **** 		if(fabsf(INS.MotionAccel_n[0])<0.02f)
 338:Robot/RoboTask/ins/ins_task.c **** 		{
 339:Robot/RoboTask/ins/ins_task.c **** 			INS.MotionAccel_n[0]=0.0f;	//x轴
 340:Robot/RoboTask/ins/ins_task.c **** 		}
 341:Robot/RoboTask/ins/ins_task.c **** 		if(fabsf(INS.MotionAccel_n[1])<0.02f)
 342:Robot/RoboTask/ins/ins_task.c **** 		{
 343:Robot/RoboTask/ins/ins_task.c **** 			INS.MotionAccel_n[1]=0.0f;	//y轴
 344:Robot/RoboTask/ins/ins_task.c **** 		}
 345:Robot/RoboTask/ins/ins_task.c **** 		if(fabsf(INS.MotionAccel_n[2])<0.04f)
 346:Robot/RoboTask/ins/ins_task.c **** 		{
 347:Robot/RoboTask/ins/ins_task.c **** 			INS.MotionAccel_n[2]=0.0f;//z轴
 348:Robot/RoboTask/ins/ins_task.c **** 		}
 349:Robot/RoboTask/ins/ins_task.c **** 
 350:Robot/RoboTask/ins/ins_task.c **** 		if(ins_time>2000.0f)
 351:Robot/RoboTask/ins/ins_task.c **** 		{
 352:Robot/RoboTask/ins/ins_task.c **** 			INS.v_n = INS.v_n+INS.MotionAccel_n[1]*0.001f;
 353:Robot/RoboTask/ins/ins_task.c **** 		  	INS.x_n = INS.x_n+INS.v_n*0.001f;
 354:Robot/RoboTask/ins/ins_task.c **** 			INS.ins_flag = 1;//四元数基本收敛，加速度也基本收敛，可以开始底盘任务
 355:Robot/RoboTask/ins/ins_task.c **** 			// 获取最终数据
 356:Robot/RoboTask/ins/ins_task.c **** 			// INS.Pitch = mahony.roll*180.0f/PI;
 357:Robot/RoboTask/ins/ins_task.c **** 			// INS.Roll = mahony.pitch*180.0f/PI;
 358:Robot/RoboTask/ins/ins_task.c **** 			// INS.Yaw = mahony.yaw*180.0f/PI;
 359:Robot/RoboTask/ins/ins_task.c **** 		
 360:Robot/RoboTask/ins/ins_task.c **** 			INS.YawTotalAngle = QEKF_INS.YawTotalAngle;
 361:Robot/RoboTask/ins/ins_task.c **** 		}
 362:Robot/RoboTask/ins/ins_task.c **** 		else
 363:Robot/RoboTask/ins/ins_task.c **** 		{
 364:Robot/RoboTask/ins/ins_task.c **** 		ins_time++;
 365:Robot/RoboTask/ins/ins_task.c **** 		}
 366:Robot/RoboTask/ins/ins_task.c **** 
 367:Robot/RoboTask/ins/ins_task.c **** 		INS.Pitch = HIPNUC.hi91.pitch;
 368:Robot/RoboTask/ins/ins_task.c **** 		INS.Roll = HIPNUC.hi91.roll;
 369:Robot/RoboTask/ins/ins_task.c **** 		INS.Yaw = HIPNUC.hi91.yaw;
 370:Robot/RoboTask/ins/ins_task.c **** 			
 371:Robot/RoboTask/ins/ins_task.c **** 		osDelay(1);
 372:Robot/RoboTask/ins/ins_task.c **** 	}
