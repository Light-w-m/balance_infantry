  49:Robot/RoboTask/ins/INS_task.c **** void INS_task(void)
  50:Robot/RoboTask/ins/INS_task.c **** {
  51:Robot/RoboTask/ins/INS_task.c **** 	 INS_Init();
  52:Robot/RoboTask/ins/INS_task.c **** 	 
  53:Robot/RoboTask/ins/INS_task.c **** 	 while(1)
  54:Robot/RoboTask/ins/INS_task.c **** 	 {  
  55:Robot/RoboTask/ins/INS_task.c **** 		ins_dt = DWT_GetDeltaT(&INS_DWT_Count);
  56:Robot/RoboTask/ins/INS_task.c ****     
  57:Robot/RoboTask/ins/INS_task.c **** 		mahony.dt = ins_dt;
  58:Robot/RoboTask/ins/INS_task.c **** 
  59:Robot/RoboTask/ins/INS_task.c **** 		BMI088_Read(&BMI088);
  60:Robot/RoboTask/ins/INS_task.c **** 
  61:Robot/RoboTask/ins/INS_task.c **** 		INS.Accel[X_AXIS] = BMI088.Accel[X_AXIS];
  62:Robot/RoboTask/ins/INS_task.c **** 		INS.Accel[Y_AXIS] = BMI088.Accel[Y_AXIS];
  63:Robot/RoboTask/ins/INS_task.c **** 		INS.Accel[Z_AXIS] = BMI088.Accel[Z_AXIS];
  64:Robot/RoboTask/ins/INS_task.c **** 
  65:Robot/RoboTask/ins/INS_task.c **** 		Accel.x=BMI088.Accel[0];
  66:Robot/RoboTask/ins/INS_task.c **** 		Accel.y=BMI088.Accel[1];
  67:Robot/RoboTask/ins/INS_task.c **** 		Accel.z=BMI088.Accel[2];
  68:Robot/RoboTask/ins/INS_task.c **** 
  69:Robot/RoboTask/ins/INS_task.c **** 		INS.Gyro[X_AXIS] = BMI088.Gyro[X_AXIS];
  70:Robot/RoboTask/ins/INS_task.c **** 		INS.Gyro[Y_AXIS] = BMI088.Gyro[Y_AXIS];
  71:Robot/RoboTask/ins/INS_task.c **** 		INS.Gyro[Z_AXIS] = BMI088.Gyro[Z_AXIS];
  72:Robot/RoboTask/ins/INS_task.c **** 
  73:Robot/RoboTask/ins/INS_task.c **** 		Gyro.x=BMI088.Gyro[0];
  74:Robot/RoboTask/ins/INS_task.c **** 		Gyro.y=BMI088.Gyro[1];
  75:Robot/RoboTask/ins/INS_task.c **** 		Gyro.z=BMI088.Gyro[2];
  76:Robot/RoboTask/ins/INS_task.c **** 
  77:Robot/RoboTask/ins/INS_task.c **** 		//核心函数，EKF更新四元数
  78:Robot/RoboTask/ins/INS_task.c **** 		// IMU_QuaternionEKF_Update(INS.Gyro[X_AXIS], INS.Gyro[Y_AXIS], INS.Gyro[Z_AXIS], INS.Accel[X_AXI
  79:Robot/RoboTask/ins/INS_task.c **** 
  80:Robot/RoboTask/ins/INS_task.c **** 		mahony_input(&mahony,Gyro,Accel);
  81:Robot/RoboTask/ins/INS_task.c **** 		mahony_update(&mahony);
  82:Robot/RoboTask/ins/INS_task.c **** 		mahony_output(&mahony);
  83:Robot/RoboTask/ins/INS_task.c **** 		RotationMatrix_update(&mahony);
  84:Robot/RoboTask/ins/INS_task.c **** 					
  85:Robot/RoboTask/ins/INS_task.c **** 		INS.q[0]=mahony.q0;
  86:Robot/RoboTask/ins/INS_task.c **** 		INS.q[1]=mahony.q1;
  87:Robot/RoboTask/ins/INS_task.c **** 		INS.q[2]=mahony.q2;
  88:Robot/RoboTask/ins/INS_task.c **** 		INS.q[3]=mahony.q3;
  89:Robot/RoboTask/ins/INS_task.c **** 		
  90:Robot/RoboTask/ins/INS_task.c **** 		// 将重力从导航坐标系n转换到机体系b,随后根据加速度计数据计算运动加�
  91:Robot/RoboTask/ins/INS_task.c **** 		float gravity_b[3];
  92:Robot/RoboTask/ins/INS_task.c **** 		EarthFrameToBodyFrame(gravity, gravity_b, INS.q);
  93:Robot/RoboTask/ins/INS_task.c **** 		for (uint8_t i = 0; i < 3; i++) // 同样过一个低通滤波
  94:Robot/RoboTask/ins/INS_task.c **** 		{
  95:Robot/RoboTask/ins/INS_task.c **** 			INS.MotionAccel_b[i] = (INS.Accel[i] - gravity_b[i]) * ins_dt / (INS.AccelLPF + ins_dt) 
  96:Robot/RoboTask/ins/INS_task.c **** 															+ INS.MotionAccel_b[i] * INS.AccelLPF / (INS.AccelLPF + ins_dt); 
  97:Robot/RoboTask/ins/INS_task.c **** 	//			INS.MotionAccel_b[i] = (INS.Accel[i] ) * dt / (INS.AccelLPF + dt) 
  98:Robot/RoboTask/ins/INS_task.c **** 	//														+ INS.MotionAccel_b[i] * INS.AccelLPF / (INS.AccelLPF + dt);			
  99:Robot/RoboTask/ins/INS_task.c **** 		}
 100:Robot/RoboTask/ins/INS_task.c **** 		BodyFrameToEarthFrame(INS.MotionAccel_b, INS.MotionAccel_n, INS.q); // 转换回导航系n
 101:Robot/RoboTask/ins/INS_task.c **** 		
 102:Robot/RoboTask/ins/INS_task.c **** 		//死区处理
 103:Robot/RoboTask/ins/INS_task.c **** 		if(fabsf(INS.MotionAccel_n[0])<0.02f)
ARM GAS  D:\temp\TMP\ccitzH6G.s 			page 4


 104:Robot/RoboTask/ins/INS_task.c **** 		{
 105:Robot/RoboTask/ins/INS_task.c **** 			INS.MotionAccel_n[0]=0.0f;	//x轴
 106:Robot/RoboTask/ins/INS_task.c **** 		}
 107:Robot/RoboTask/ins/INS_task.c **** 		if(fabsf(INS.MotionAccel_n[1])<0.02f)
 108:Robot/RoboTask/ins/INS_task.c **** 		{
 109:Robot/RoboTask/ins/INS_task.c **** 			INS.MotionAccel_n[1]=0.0f;	//y轴
 110:Robot/RoboTask/ins/INS_task.c **** 		}
 111:Robot/RoboTask/ins/INS_task.c **** 		if(fabsf(INS.MotionAccel_n[2])<0.04f)
 112:Robot/RoboTask/ins/INS_task.c **** 		{
 113:Robot/RoboTask/ins/INS_task.c **** 			INS.MotionAccel_n[2]=0.0f;//z轴
 114:Robot/RoboTask/ins/INS_task.c **** 		}
 115:Robot/RoboTask/ins/INS_task.c **** 		
 116:Robot/RoboTask/ins/INS_task.c **** 		if(ins_time>3000.0f)
 117:Robot/RoboTask/ins/INS_task.c **** 		{
 118:Robot/RoboTask/ins/INS_task.c **** 			INS.v_n=INS.v_n+INS.MotionAccel_n[1]*0.001f;
 119:Robot/RoboTask/ins/INS_task.c **** 		  	INS.x_n=INS.x_n+INS.v_n*0.001f;
 120:Robot/RoboTask/ins/INS_task.c **** 			INS.ins_flag=1;//四元数基本收敛，加速度也基本收敛，可以开始底盘任务
 121:Robot/RoboTask/ins/INS_task.c **** 			// 获取最终数据
 122:Robot/RoboTask/ins/INS_task.c **** 			INS.Pitch=mahony.roll*180.0f/PI;
 123:Robot/RoboTask/ins/INS_task.c **** 			INS.Roll=mahony.pitch*180.0f/PI;
 124:Robot/RoboTask/ins/INS_task.c **** 			INS.Yaw=mahony.yaw*180.0f/PI;
 125:Robot/RoboTask/ins/INS_task.c **** 		
 126:Robot/RoboTask/ins/INS_task.c **** 			//INS.YawTotalAngle=INS.YawTotalAngle+INS.Gyro[2]*0.001f;
 127:Robot/RoboTask/ins/INS_task.c **** 			
 128:Robot/RoboTask/ins/INS_task.c **** 			if (INS.Yaw - INS.YawAngleLast > 3.1415926f)
 129:Robot/RoboTask/ins/INS_task.c **** 			{
 130:Robot/RoboTask/ins/INS_task.c **** 					INS.YawRoundCount--;
 131:Robot/RoboTask/ins/INS_task.c **** 			}
 132:Robot/RoboTask/ins/INS_task.c **** 			else if (INS.Yaw - INS.YawAngleLast < -3.1415926f)
 133:Robot/RoboTask/ins/INS_task.c **** 			{
 134:Robot/RoboTask/ins/INS_task.c **** 					INS.YawRoundCount++;
 135:Robot/RoboTask/ins/INS_task.c **** 			}
 136:Robot/RoboTask/ins/INS_task.c **** 			INS.YawTotalAngle = (6.283f* INS.YawRoundCount + INS.Yaw) * 180.0f / PI;
 137:Robot/RoboTask/ins/INS_task.c **** 			INS.YawAngleLast = INS.Yaw*180.0f/PI;
 138:Robot/RoboTask/ins/INS_task.c **** 		}
 139:Robot/RoboTask/ins/INS_task.c **** 		else
 140:Robot/RoboTask/ins/INS_task.c **** 		{
 141:Robot/RoboTask/ins/INS_task.c **** 		ins_time++;
 142:Robot/RoboTask/ins/INS_task.c **** 		}
 143:Robot/RoboTask/ins/INS_task.c **** 			
 144:Robot/RoboTask/ins/INS_task.c **** 		osDelay(1);
 145:Robot/RoboTask/ins/INS_task.c **** 	}
 146:Robot/RoboTask/ins/INS_task.c **** } 
