 113:Robot/RoboTask/ins/ins_task.c **** 
 114:Robot/RoboTask/ins/ins_task.c **** void INS_task(void)
 115:Robot/RoboTask/ins/ins_task.c **** {
 116:Robot/RoboTask/ins/ins_task.c **** 	 INS_Init();
 117:Robot/RoboTask/ins/ins_task.c **** 	 
 118:Robot/RoboTask/ins/ins_task.c **** 	 while(1)
 119:Robot/RoboTask/ins/ins_task.c **** 	 {  
 120:Robot/RoboTask/ins/ins_task.c **** 		ins_dt = DWT_GetDeltaT(&INS_DWT_Count);
 121:Robot/RoboTask/ins/ins_task.c ****     
 122:Robot/RoboTask/ins/ins_task.c **** 		mahony.dt = ins_dt;
 123:Robot/RoboTask/ins/ins_task.c **** 
 124:Robot/RoboTask/ins/ins_task.c **** 		BMI088_Read(&BMI088);
 125:Robot/RoboTask/ins/ins_task.c **** 
 126:Robot/RoboTask/ins/ins_task.c **** 		INS.Accel[X_AXIS] = BMI088.Accel[X_AXIS];
 127:Robot/RoboTask/ins/ins_task.c **** 		INS.Accel[Y_AXIS] = BMI088.Accel[Y_AXIS];
 128:Robot/RoboTask/ins/ins_task.c **** 		INS.Accel[Z_AXIS] = BMI088.Accel[Z_AXIS];
 129:Robot/RoboTask/ins/ins_task.c **** 
 130:Robot/RoboTask/ins/ins_task.c **** 		Accel.x=BMI088.Accel[0];
 131:Robot/RoboTask/ins/ins_task.c **** 		Accel.y=BMI088.Accel[1];
 132:Robot/RoboTask/ins/ins_task.c **** 		Accel.z=BMI088.Accel[2];
 133:Robot/RoboTask/ins/ins_task.c **** 
 134:Robot/RoboTask/ins/ins_task.c **** 		INS.Gyro[X_AXIS] = BMI088.Gyro[X_AXIS];
 135:Robot/RoboTask/ins/ins_task.c **** 		INS.Gyro[Y_AXIS] = BMI088.Gyro[Y_AXIS];
 136:Robot/RoboTask/ins/ins_task.c **** 		INS.Gyro[Z_AXIS] = BMI088.Gyro[Z_AXIS];
 137:Robot/RoboTask/ins/ins_task.c **** 
 138:Robot/RoboTask/ins/ins_task.c **** 		Gyro.x=BMI088.Gyro[0];
 139:Robot/RoboTask/ins/ins_task.c **** 		Gyro.y=BMI088.Gyro[1];
 140:Robot/RoboTask/ins/ins_task.c **** 		Gyro.z=BMI088.Gyro[2];
 141:Robot/RoboTask/ins/ins_task.c **** 
 142:Robot/RoboTask/ins/ins_task.c **** 		//核心函数，EKF更新四元数
 143:Robot/RoboTask/ins/ins_task.c **** 		IMU_QuaternionEKF_Update(INS.Gyro[X_AXIS], INS.Gyro[Y_AXIS], INS.Gyro[Z_AXIS], INS.Accel[X_AXIS],
 144:Robot/RoboTask/ins/ins_task.c **** 
 145:Robot/RoboTask/ins/ins_task.c **** 		mahony_input(&mahony,Gyro,Accel);
 146:Robot/RoboTask/ins/ins_task.c **** 		mahony_update(&mahony);
 147:Robot/RoboTask/ins/ins_task.c **** 		mahony_output(&mahony);
 148:Robot/RoboTask/ins/ins_task.c **** 		RotationMatrix_update(&mahony);
 149:Robot/RoboTask/ins/ins_task.c **** 					
 150:Robot/RoboTask/ins/ins_task.c **** 		INS.q[0]=mahony.q0;
 151:Robot/RoboTask/ins/ins_task.c **** 		INS.q[1]=mahony.q1;
 152:Robot/RoboTask/ins/ins_task.c **** 		INS.q[2]=mahony.q2;
 153:Robot/RoboTask/ins/ins_task.c **** 		INS.q[3]=mahony.q3;
 154:Robot/RoboTask/ins/ins_task.c **** 
