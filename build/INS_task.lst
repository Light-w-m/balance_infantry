 156:Robot/RoboTask/ins/ins_task.c **** 		
 157:Robot/RoboTask/ins/ins_task.c **** 		// 将重力从导航坐标系n转换到机体系b,随后根据加速度计数据计算运动加�
 158:Robot/RoboTask/ins/ins_task.c **** 		float gravity_b[3];
 159:Robot/RoboTask/ins/ins_task.c **** 		EarthFrameToBodyFrame(gravity, gravity_b, INS.q);
 160:Robot/RoboTask/ins/ins_task.c **** 		for (uint8_t i = 0; i < 3; i++) // 同样过一个低通滤波
 161:Robot/RoboTask/ins/ins_task.c **** 		{
 162:Robot/RoboTask/ins/ins_task.c **** 			INS.MotionAccel_b[i] = (INS.Accel[i] - gravity_b[i]) * ins_dt / (INS.AccelLPF + ins_dt) 
 163:Robot/RoboTask/ins/ins_task.c **** 															+ INS.MotionAccel_b[i] * INS.AccelLPF / (INS.AccelLPF + ins_dt); 
 164:Robot/RoboTask/ins/ins_task.c **** 	//			INS.MotionAccel_b[i] = (INS.Accel[i] ) * dt / (INS.AccelLPF + dt) 
 165:Robot/RoboTask/ins/ins_task.c **** 	//														+ INS.MotionAccel_b[i] * INS.AccelLPF / (INS.AccelLPF + dt);			
 166:Robot/RoboTask/ins/ins_task.c **** 		}
 167:Robot/RoboTask/ins/ins_task.c **** 		BodyFrameToEarthFrame(INS.MotionAccel_b, INS.MotionAccel_n, INS.q); // 转换回导航系n
 168:Robot/RoboTask/ins/ins_task.c **** 		
 169:Robot/RoboTask/ins/ins_task.c **** 		//死区处理
 170:Robot/RoboTask/ins/ins_task.c **** 		if(fabsf(INS.MotionAccel_n[0])<0.02f)
