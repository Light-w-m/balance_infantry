 133:Robot/Devices/BMI088/BMI088driver.c ****         BMI088.GyroOffset[1] = GyOFFSET;
 134:Robot/Devices/BMI088/BMI088driver.c ****         BMI088.GyroOffset[2] = GzOFFSET;
 135:Robot/Devices/BMI088/BMI088driver.c **** 			
 136:Robot/Devices/BMI088/BMI088driver.c **** 				BMI088.AccelOffset[0]= AxOFFSET;
 137:Robot/Devices/BMI088/BMI088driver.c **** 			  BMI088.AccelOffset[1]= AyOFFSET;
 138:Robot/Devices/BMI088/BMI088driver.c **** 			  BMI088.AccelOffset[2]= AzOFFSET;
 139:Robot/Devices/BMI088/BMI088driver.c **** 			
 140:Robot/Devices/BMI088/BMI088driver.c ****         BMI088.gNorm = gNORM;
