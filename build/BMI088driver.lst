 148:Robot/Devices/BMI088/BMI088driver.c **** // 校准零漂
 149:Robot/Devices/BMI088/BMI088driver.c **** void Calibrate_MPU_Offset(IMU_Data_t *bmi088)
 150:Robot/Devices/BMI088/BMI088driver.c **** {
 151:Robot/Devices/BMI088/BMI088driver.c ****     static float startTime;
 152:Robot/Devices/BMI088/BMI088driver.c ****     static uint16_t CaliTimes = 6000; // 需要足够多的数据才能得到有效陀螺仪零偏�
 153:Robot/Devices/BMI088/BMI088driver.c **** 	  static uint16_t acc_CaliTimes = 6000; // 需要足够多的数据才能得到有效加速度计�
 154:Robot/Devices/BMI088/BMI088driver.c ****     uint8_t buf[8] = {0, 0, 0, 0, 0, 0};
 155:Robot/Devices/BMI088/BMI088driver.c ****     int16_t bmi088_raw_temp;
 156:Robot/Devices/BMI088/BMI088driver.c ****     float gyroMax[3], gyroMin[3];
 157:Robot/Devices/BMI088/BMI088driver.c ****     float gNormTemp, gNormMax, gNormMin;
 158:Robot/Devices/BMI088/BMI088driver.c **** 
 159:Robot/Devices/BMI088/BMI088driver.c ****     startTime = DWT_GetTimeline_s();
 160:Robot/Devices/BMI088/BMI088driver.c ****     do
 161:Robot/Devices/BMI088/BMI088driver.c ****     {
 162:Robot/Devices/BMI088/BMI088driver.c ****         if (DWT_GetTimeline_s() - startTime > 10)
 163:Robot/Devices/BMI088/BMI088driver.c ****         {
 164:Robot/Devices/BMI088/BMI088driver.c ****             // 校准超时
 165:Robot/Devices/BMI088/BMI088driver.c ****             bmi088->GyroOffset[0] = GxOFFSET;
 166:Robot/Devices/BMI088/BMI088driver.c ****             bmi088->GyroOffset[1] = GyOFFSET;
 167:Robot/Devices/BMI088/BMI088driver.c ****             bmi088->GyroOffset[2] = GzOFFSET;
 168:Robot/Devices/BMI088/BMI088driver.c ****             bmi088->gNorm = gNORM;
 169:Robot/Devices/BMI088/BMI088driver.c ****             bmi088->TempWhenCali = 40;
 170:Robot/Devices/BMI088/BMI088driver.c ****             break;
 171:Robot/Devices/BMI088/BMI088driver.c ****         }
 172:Robot/Devices/BMI088/BMI088driver.c **** 
 173:Robot/Devices/BMI088/BMI088driver.c ****         DWT_Delay(0.005);
 174:Robot/Devices/BMI088/BMI088driver.c ****         bmi088->gNorm = 0;
 175:Robot/Devices/BMI088/BMI088driver.c ****         bmi088->GyroOffset[0] = 0;
 176:Robot/Devices/BMI088/BMI088driver.c ****         bmi088->GyroOffset[1] = 0;
 177:Robot/Devices/BMI088/BMI088driver.c ****         bmi088->GyroOffset[2] = 0;
 178:Robot/Devices/BMI088/BMI088driver.c **** 
 179:Robot/Devices/BMI088/BMI088driver.c ****         for (uint16_t i = 0; i < CaliTimes; i++)
 180:Robot/Devices/BMI088/BMI088driver.c ****         {
 181:Robot/Devices/BMI088/BMI088driver.c ****             BMI088_accel_read_muli_reg(BMI088_ACCEL_XOUT_L, buf, 6);
 182:Robot/Devices/BMI088/BMI088driver.c ****             bmi088_raw_temp = (int16_t)((buf[1]) << 8) | buf[0];
 183:Robot/Devices/BMI088/BMI088driver.c ****             bmi088->Accel[0] = bmi088_raw_temp * BMI088_ACCEL_SEN;
 184:Robot/Devices/BMI088/BMI088driver.c ****             bmi088_raw_temp = (int16_t)((buf[3]) << 8) | buf[2];
 185:Robot/Devices/BMI088/BMI088driver.c ****             bmi088->Accel[1] = bmi088_raw_temp * BMI088_ACCEL_SEN;
 186:Robot/Devices/BMI088/BMI088driver.c ****             bmi088_raw_temp = (int16_t)((buf[5]) << 8) | buf[4];
 187:Robot/Devices/BMI088/BMI088driver.c ****             bmi088->Accel[2] = bmi088_raw_temp * BMI088_ACCEL_SEN;
 188:Robot/Devices/BMI088/BMI088driver.c ****             gNormTemp = sqrtf(bmi088->Accel[0] * bmi088->Accel[0] +
 189:Robot/Devices/BMI088/BMI088driver.c ****                               bmi088->Accel[1] * bmi088->Accel[1] +
 190:Robot/Devices/BMI088/BMI088driver.c ****                               bmi088->Accel[2] * bmi088->Accel[2]);
 191:Robot/Devices/BMI088/BMI088driver.c ****             bmi088->gNorm += gNormTemp;
 192:Robot/Devices/BMI088/BMI088driver.c **** 
 193:Robot/Devices/BMI088/BMI088driver.c ****             BMI088_gyro_read_muli_reg(BMI088_GYRO_CHIP_ID, buf, 8);
 194:Robot/Devices/BMI088/BMI088driver.c ****             if (buf[0] == BMI088_GYRO_CHIP_ID_VALUE)
 195:Robot/Devices/BMI088/BMI088driver.c ****             {
 196:Robot/Devices/BMI088/BMI088driver.c ****                 bmi088_raw_temp = (int16_t)((buf[3]) << 8) | buf[2];
 197:Robot/Devices/BMI088/BMI088driver.c ****                 bmi088->Gyro[0] = bmi088_raw_temp * BMI088_GYRO_SEN;
 198:Robot/Devices/BMI088/BMI088driver.c ****                 bmi088->GyroOffset[0] += bmi088->Gyro[0];//累积零飘值
 199:Robot/Devices/BMI088/BMI088driver.c ****                 bmi088_raw_temp = (int16_t)((buf[5]) << 8) | buf[4];
 200:Robot/Devices/BMI088/BMI088driver.c ****                 bmi088->Gyro[1] = bmi088_raw_temp * BMI088_GYRO_SEN;
 201:Robot/Devices/BMI088/BMI088driver.c ****                 bmi088->GyroOffset[1] += bmi088->Gyro[1];
 202:Robot/Devices/BMI088/BMI088driver.c ****                 bmi088_raw_temp = (int16_t)((buf[7]) << 8) | buf[6];
ARM GAS  D:\temp\TMP\ccizuJcx.s 			page 5


 203:Robot/Devices/BMI088/BMI088driver.c ****                 bmi088->Gyro[2] = bmi088_raw_temp * BMI088_GYRO_SEN;
 204:Robot/Devices/BMI088/BMI088driver.c ****                 bmi088->GyroOffset[2] += bmi088->Gyro[2];
 205:Robot/Devices/BMI088/BMI088driver.c ****             }
 206:Robot/Devices/BMI088/BMI088driver.c **** 
 207:Robot/Devices/BMI088/BMI088driver.c ****             // 记录数据极差
 208:Robot/Devices/BMI088/BMI088driver.c ****             if (i == 0)
 209:Robot/Devices/BMI088/BMI088driver.c ****             {
 210:Robot/Devices/BMI088/BMI088driver.c ****                 gNormMax = gNormTemp;
 211:Robot/Devices/BMI088/BMI088driver.c ****                 gNormMin = gNormTemp;
 212:Robot/Devices/BMI088/BMI088driver.c ****                 for (uint8_t j = 0; j < 3; j++)
 213:Robot/Devices/BMI088/BMI088driver.c ****                 {
 214:Robot/Devices/BMI088/BMI088driver.c ****                     gyroMax[j] = bmi088->Gyro[j];
 215:Robot/Devices/BMI088/BMI088driver.c ****                     gyroMin[j] = bmi088->Gyro[j];
 216:Robot/Devices/BMI088/BMI088driver.c ****                 }
 217:Robot/Devices/BMI088/BMI088driver.c ****             }
 218:Robot/Devices/BMI088/BMI088driver.c ****             else
 219:Robot/Devices/BMI088/BMI088driver.c ****             {//更新最大最小值
 220:Robot/Devices/BMI088/BMI088driver.c ****                 if (gNormTemp > gNormMax)
 221:Robot/Devices/BMI088/BMI088driver.c ****                     gNormMax = gNormTemp;
 222:Robot/Devices/BMI088/BMI088driver.c ****                 if (gNormTemp < gNormMin)
 223:Robot/Devices/BMI088/BMI088driver.c ****                     gNormMin = gNormTemp;
 224:Robot/Devices/BMI088/BMI088driver.c ****                 for (uint8_t j = 0; j < 3; j++)
 225:Robot/Devices/BMI088/BMI088driver.c ****                 {
 226:Robot/Devices/BMI088/BMI088driver.c ****                     if (bmi088->Gyro[j] > gyroMax[j])
 227:Robot/Devices/BMI088/BMI088driver.c ****                         gyroMax[j] = bmi088->Gyro[j];
 228:Robot/Devices/BMI088/BMI088driver.c ****                     if (bmi088->Gyro[j] < gyroMin[j])
 229:Robot/Devices/BMI088/BMI088driver.c ****                         gyroMin[j] = bmi088->Gyro[j];
 230:Robot/Devices/BMI088/BMI088driver.c ****                 }
 231:Robot/Devices/BMI088/BMI088driver.c ****             }
 232:Robot/Devices/BMI088/BMI088driver.c **** 
 233:Robot/Devices/BMI088/BMI088driver.c ****             // 数据差异过大认为收到外界干扰，需重新校准
 234:Robot/Devices/BMI088/BMI088driver.c ****             gNormDiff = gNormMax - gNormMin;
 235:Robot/Devices/BMI088/BMI088driver.c ****             for (uint8_t j = 0; j < 3; j++)
